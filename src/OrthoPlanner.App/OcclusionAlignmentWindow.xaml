<Window x:Class="OrthoPlanner.App.OcclusionAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Occlusion Alignment Wizard" Width="1200" Height="750"
        WindowStartupLocation="CenterOwner" Background="#FF0C1018" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Occlusion Alignment" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock FontSize="11" Foreground="#AAB" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Align both the Maxilla and Mandible to the imported Occlusion STL. Pick landmarks on the bone and corresponding points on the occlusion."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Currently Aligning: " VerticalAlignment="Center" Foreground="#CCC" Margin="0,0,8,0" />
            <ComboBox x:Name="BoneSelector" Width="150" SelectionChanged="BoneSelector_SelectionChanged">
                <ComboBoxItem Content="Maxilla" IsSelected="True" />
                <ComboBoxItem Content="Mandible" />
            </ComboBox>
        </StackPanel>

        <!-- Dual viewports -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bone model -->
            <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX ShowCameraTarget="False" x:Name="BoneViewport" BackgroundColor="#FF0E1420"
                                           ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                           ZoomExtentsWhenLoaded="False"
                                           IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                           CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                           ShowViewCube="False" IsInertiaEnabled="False"
                                           PreviewMouseLeftButtonDown="BoneViewport_PreviewMouseLeftButtonDown"
                                           PreviewMouseRightButtonDown="BoneViewport_PreviewMouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="BoneCamera" Position="0,-300,100" LookDirection="0,1,-0.3" UpDirection="0,0,1" FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="BoneHeadlamp" Direction="0,-1,0" Color="#D0D0D0" />
                        <hx:DirectionalLight3D x:Name="BoneBacklamp" Direction="0,1,0" Color="#A0A0A0" />
                        <hx:GroupModel3D x:Name="BoneGroup" />
                    </hx:Viewport3DX>
                    <TextBlock x:Name="BoneLabel" Text="🦴 Bone Surface" FontSize="11" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Occlusion STL -->
            <Border Grid.Column="2" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX ShowCameraTarget="False" x:Name="OccViewport" BackgroundColor="#FF0E1420"
                                           ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                           ZoomExtentsWhenLoaded="False"
                                           IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                           CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                           ShowViewCube="False" IsInertiaEnabled="False"
                                           PreviewMouseLeftButtonDown="OccViewport_PreviewMouseLeftButtonDown"
                                           PreviewMouseRightButtonDown="OccViewport_PreviewMouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="OccCamera" Position="0,-300,0" LookDirection="0,1,0" UpDirection="0,0,1" FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="OccHeadlamp" Direction="0,-1,0" Color="#D0D0D0" />
                        <hx:DirectionalLight3D x:Name="OccBacklamp" Direction="0,1,0" Color="#A0A0A0" />
                        <hx:GroupModel3D x:Name="OccGroup" />
                    </hx:Viewport3DX>
                    <TextBlock Text="🦷 Occlusion STL" FontSize="11" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Margin="0,6,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="6" Height="30">
            <TextBlock x:Name="StatusText" Text="Select points on Bone and Occlusion. Need 3 pairs." Foreground="#AAB" VerticalAlignment="Center" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Clear Markers" Padding="10,6" Background="#30FFFFFF" Foreground="White" BorderThickness="0" Click="Clear_Click" Margin="0,0,8,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="RmsText" Text="" FontSize="11" Foreground="#8CF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ComputeMaxillaBtn" Content="⚡ Align Maxilla" Padding="10,6" Margin="0,0,8,0" Background="#FF1B98E0" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="ComputeMaxilla_Click"/>
                    <Button x:Name="ComputeMandibleBtn" Content="⚡ Align Mandible" Padding="10,6" Margin="0,0,8,0" Background="#FF1B98E0" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="ComputeMandible_Click"/>
                    <Button x:Name="AcceptBtn" Content="✔ Accept Both" Padding="10,6" Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Accept_Click" IsEnabled="False"/>
                    <Button Content="Cancel" Padding="10,6" Margin="8,0,0,0" Background="#30FFFFFF" Foreground="White" BorderThickness="0" Click="Cancel_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
