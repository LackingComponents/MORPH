<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>OrthoPlanner</AssemblyName>
    <RootNamespace>OrthoPlanner.App</RootNamespace>
    <!-- Required for ManifoldNET native DLL targets to activate on x64 -->
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Required for pointer-based WriteHalf in VolumeRenderingViewModel -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Explicitly copy ManifoldNET native DLLs to output (targets file requires Prefer32Bit=false) -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)manifoldnet\1.0.7-alpha\runtimes\win-x64\native\manifoldc.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>manifoldc.dll</Link>
    </None>
    <None Include="$(NuGetPackageRoot)manifoldnet\1.0.7-alpha\runtimes\win-x64\native\tbb12.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tbb12.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrthoPlanner.Core\OrthoPlanner.Core.csproj" />
    <ProjectReference Include="..\OrthoPlanner.Infrastructure\OrthoPlanner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="ManifoldNET" Version="1.0.7-alpha" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.png" />
    <Resource Include="Resources\splash.png" />
  </ItemGroup>

</Project>
