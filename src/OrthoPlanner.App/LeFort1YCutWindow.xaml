<Window x:Class="OrthoPlanner.App.LeFort1YCutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="LeFort 1 — 3-Piece Y-Shape Cut" Width="1100" Height="800"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E1420" Foreground="White" FontFamily="Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="StepTitle" Text="LeFort 1 — 3-Piece: Place 2 Vestibular Points" FontSize="16" FontWeight="SemiBold" Foreground="#EAECF0"/>
            <TextBlock x:Name="StepInstructions"
                       Text="Step 1: Left-click on the vestibular surface of the maxilla to place exactly 2 points. A Y-shaped cut (sagittal midline + two parasagittal cuts) will be generated."
                       FontSize="11" Foreground="#88AABB" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,8" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <hx:Viewport3DX x:Name="MainViewport" BackgroundColor="#FF080C14"
                            ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                            ZoomExtentsWhenLoaded="False"
                            IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                            RotateAroundMouseDownPoint="False"
                            CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                            ShowViewCube="False" IsInertiaEnabled="False"
                            PreviewMouseLeftButtonDown="Viewport_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="Viewport_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="Viewport_PreviewMouseLeftButtonUp">
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera x:Name="SubCamera" Position="0,-300,100" LookDirection="0,1,-0.3"
                                          UpDirection="0,0,1" FieldOfView="45"
                                          NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                </hx:Viewport3DX.Camera>
                <hx:AmbientLight3D Color="#606060" />
                <hx:DirectionalLight3D x:Name="Headlamp" Direction="0,-1,0" Color="#E0E0E0" />
                <hx:DirectionalLight3D x:Name="Backlamp" Direction="0,1,0" Color="#C8C8C8" />
                <hx:GroupModel3D x:Name="MainGroup" />
            </hx:Viewport3DX>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="" FontSize="10" Foreground="#AAB" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" Width="80" Height="28"
                    Background="#20FFFFFF" Foreground="White" BorderBrush="#40FFFFFF" Cursor="Hand"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ClearBtn" Content="Clear Points" Click="Clear_Click" Width="100" Height="28"
                        Background="#305040" Foreground="White" BorderBrush="#407050" Cursor="Hand" Margin="0,0,8,0"/>
                <Button x:Name="NextBtn" Content="Next Step" Click="Next_Click" Width="100" Height="28"
                        Background="#3060A0" Foreground="White" BorderBrush="#4080C0" Cursor="Hand" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="CutBtn" Content="Perform Cut" Click="Cut_Click" Width="120" Height="28"
                        Background="#3060A0" Foreground="White" BorderBrush="#4080C0" Cursor="Hand" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button x:Name="AcceptBtn" Content="Accept &amp; Close" Click="Accept_Click" Width="120" Height="28"
                        Background="#308040" Foreground="White" BorderBrush="#40A060" Cursor="Hand" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
