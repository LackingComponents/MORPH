<Window x:Class="OrthoPlanner.App.MandibleAutorotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Splint Planner — Mandibular Autorotation" Width="1180" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C1018" Foreground="White"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock Text="Step 0: Open the bite (mandibular autorotation)"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="StepInstructions" FontSize="11" Foreground="#AABBCC" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Lateral view. The mandible hinges open around the condylar axis (fulcrum at the condyle centers). Set the opening angle in tenths of a degree, then click Apply to proceed to splint generation."/>
        </StackPanel>

        <!-- Lateral 3D viewport -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
            <Grid>
                <hx:Viewport3DX x:Name="MainViewport" BackgroundColor="#FF0E1420"
                                ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                ZoomExtentsWhenLoaded="False"
                                IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                RotateAroundMouseDownPoint="False"
                                CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                ShowViewCube="False" IsInertiaEnabled="False">
                    <hx:Viewport3DX.Camera>
                        <hx:PerspectiveCamera x:Name="MainCamera"
                                              Position="-400,0,0" LookDirection="1,0,0"
                                              UpDirection="0,0,1" FieldOfView="40"
                                              NearPlaneDistance="0.1" FarPlaneDistance="20000"/>
                    </hx:Viewport3DX.Camera>
                    <hx:AmbientLight3D Color="#505050"/>
                    <hx:DirectionalLight3D x:Name="Headlamp" Direction="1,0,0"  Color="#D0D0D0"/>
                    <hx:DirectionalLight3D x:Name="Backlamp" Direction="-1,0,0" Color="#808080"/>
                    <hx:GroupModel3D x:Name="SceneGroup"/>
                </hx:Viewport3DX>
                <TextBlock Text="Lateral view — mandible hinges about the condylar axis"
                           FontSize="11" Foreground="#88FFFFFF"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="MANDIBULAR OPENING" FontSize="12" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,10"/>

                <TextBlock Text="Opening angle (about condylar axis):" FontSize="11" Foreground="#AABBCC" TextWrapping="Wrap"/>
                <TextBlock x:Name="AngleLabel" Text="0.0°" FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,8,0,8"/>

                <Slider x:Name="AngleSlider" Minimum="0" Maximum="20" Value="0"
                        SmallChange="0.1" LargeChange="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Margin="0,0,0,12" ValueChanged="AngleSlider_ValueChanged"/>

                <UniformGrid Columns="4" Margin="0,0,0,6">
                    <Button Content="−1°"   Margin="2" Padding="4" Click="DecCoarse_Click"  Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                    <Button Content="−0.1°" Margin="2" Padding="4" Click="DecFine_Click"    Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                    <Button Content="+0.1°" Margin="2" Padding="4" Click="IncFine_Click"    Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                    <Button Content="+1°"   Margin="2" Padding="4" Click="IncCoarse_Click"  Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                </UniformGrid>

                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Fulcrum (condylar axis)" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="FulcrumLabel" Text="" FontSize="10" Foreground="#AABBCC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Inter-arch clearance" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ClearanceLabel" Text="—" FontSize="10" Foreground="#AABBCC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="WarningLabel" Text="" FontSize="10" Foreground="#F80" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reset to 0°" Padding="8,4" HorizontalAlignment="Left"
                    Background="#30FFFFFF" Foreground="White" BorderThickness="0" Click="Reset_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ApplyBtn" Content="✔ Apply &amp; Continue" Padding="12,6" Margin="0,0,8,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Click="ApplyBtn_Click"/>
                <Button Content="Cancel" Padding="12,6"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0" Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
