                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Smoothing Passes:" Foreground="#FFA0AAB5" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Text="{Binding CustomSmoothingPasses, UpdateSourceTrigger=LostFocus}" Background="#FF30343D" Foreground="White" BorderThickness="0" TextAlignment="Center" Padding="2" FontSize="11" PreviewKeyDown="OptionsTextBox_PreviewKeyDown"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </Expander>


                                </StackPanel>
                            </Expander>

                        <!-- 2. PREPARE SURGICAL MODELS -->
                        <Expander IsExpanded="False" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12,5.5 C 10,4.5 7,4 7,7.5 C 7,10 7.5,14 7.5,17 C 7.5,19.5 9,20.5 9.5,20.5 C 10,20.5 11.5,17 12,15.5 C 12.5,17 14,20.5 14.5,20.5 C 15,20.5 16.5,19.5 16.5,17 C 16.5,14 17,10 17,7.5 C 17,4 14,4.5 12,5.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Prepare Surgical Models" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="Import dental cast STL files and align them to the CT volume."
                                           TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Button Content="Load Dental Scans" Command="{Binding ImportStlCommand}" Margin="0,0,0,4" />
                                <Button Content="Edit Dental Scans" Command="{Binding EditDentalCastsCommand}" Margin="0,0,0,4" />
                                <Button Content="Split Cranium / Mandible" Command="{Binding SplitCraniumMandibleCommand}" Margin="0,0,0,4" />
                                <Button Content="Align to CT" Command="{Binding AlignDentalScansCommand}" Margin="0,0,0,4" />
                                <Button Content="Clean &amp; Merge Casts" Command="{Binding CleanMergeCastCommand}" Margin="0,0,0,4" />
                                <CheckBox Content="Make meshes watertight" IsChecked="{Binding CloseHolesAfterMerge}" 
                                          Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding ImportedMeshes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,3" Margin="0,1" CornerRadius="3" Background="#10FFFFFF">
                                                <Border.ContextMenu>
                                                    <ContextMenu Background="#FF1E222A" BorderThickness="1" BorderBrush="#FF30343D" Foreground="White">
                                                        <MenuItem StaysOpenOnClick="True" Focusable="False" Background="Transparent" Padding="0">
                                                            <MenuItem.Header>
                                                                <StackPanel Width="170" Margin="2">
                                                                    <TextBlock Text="Transparency" FontSize="11" Foreground="#FFA0AAB5" Margin="0,0,0,4"/>
                                                                    <DockPanel>
                                                                        <TextBox DockPanel.Dock="Right" Width="45" Margin="4,0,0,0" Text="{Binding OpacityPercent, StringFormat=\{0:F0\}, UpdateSourceTrigger=LostFocus}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" FontSize="11" VerticalAlignment="Center" />
                                                                        <Slider Minimum="0" Maximum="100" Value="{Binding OpacityPercent}" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </MenuItem.Header>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <DockPanel Background="Transparent">
                                                    <CheckBox IsChecked="{Binding IsVisible}" DockPanel.Dock="Left"
                                                              VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <Button DockPanel.Dock="Right" Content="✕"
                                                            Background="Transparent" BorderThickness="0" Foreground="#888"
                                                            Padding="3,0" VerticalAlignment="Center" Cursor="Hand"
                                                            Command="{Binding DataContext.DeleteImportedMeshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="Delete" />
                                                    <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- 3. PHOTOGRAMMETRY -->
                        <Expander Header="📷  Photogrammetry" IsExpanded="{Binding IsPhotogrammetryOpen, Mode=TwoWay}" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="Import and align facial photographs for soft tissue analysis."
                                           TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Expander>

                        <!-- 4. CEPHALOMETRY -->
                        <Expander Header="📐  Cephalometry" IsExpanded="{Binding IsCephalometryOpen, Mode=TwoWay}" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="Generate a lateral DRR from the CT volume and place cephalometric landmarks."
                                           TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Expander>

                        <!-- 5. PLAN OSTEOTOMIES -->
                        <Expander Header="✂  Plan Osteotomies" IsExpanded="False" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="Define cut planes for Le Fort I, BSSO, and genioplasty osteotomies."
                                           TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Button Content="Plan Le Fort 1" Command="{Binding PlanLeFort1Command}" Margin="0,0,0,4"
                                        Background="#FF1B98E0" Foreground="White" FontWeight="Bold" />
                                <Button Content="LeFort 1 — 2-Piece Sagittal" Command="{Binding PlanLeFort1SagittalCutCommand}"
                                        Margin="0,0,0,4" IsEnabled="{Binding HasLeFort1Maxilla}"
                                        Background="#FF1B6AB0" Foreground="White" FontWeight="Normal"
                                        ToolTip="Splits the separated LeFort 1 maxilla with a sagittal midline cut (requires LeFort 1 to be performed first)"/>
                                <Button Content="LeFort 1 — 3-Piece Y-Cut" Command="{Binding PlanLeFort1YCutCommand}"
                                        Margin="0,0,0,4" IsEnabled="{Binding HasLeFort1Maxilla}"
                                        Background="#FF1B6AB0" Foreground="White" FontWeight="Normal"
                                        ToolTip="Splits the separated LeFort 1 maxilla with a Y-shaped cut yielding Left, Right and Central segments (requires LeFort 1 to be performed first)"/>
                                <Button Content="Plan BSSO" Command="{Binding PlanBssoCommand}" Margin="0,0,0,4"
                                        Background="#FF1B98E0" Foreground="White" FontWeight="Bold" />
                                <Button Content="Plan Genioplasty" Command="{Binding PlanGenioplastyCommand}" Margin="0,0,0,4"
                                        Background="#FF1B98E0" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Expander>

                        <!-- 6. SPLINT GENERATION -->
                        <Expander Header="🔧  Splint Generation" IsExpanded="False" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="Design surgical occlusal splints from arch curves fitted to the dental models."
                                           TextWrapping="Wrap" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Button Content="⚙  Final Occlusion Splint"
                                        Command="{Binding OpenSplintPlannerCommand}"
                                        Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>


                    </StackPanel>
                </ScrollViewer>

                <!-- Fixed 3D Models List at Bottom -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6" Background="{StaticResource BgMediumBrush}">
                    <StackPanel>
                        <TextBlock Text="3D MODELS" Style="{StaticResource PanelHeader}" FontSize="9" Margin="0,0,0,4" />
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,3" Margin="0,1" CornerRadius="3" Background="#10FFFFFF">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="#FF1E222A" BorderThickness="1" BorderBrush="#FF30343D" Foreground="White">
                                                    <MenuItem StaysOpenOnClick="True" Focusable="False" Background="Transparent" Padding="0">
                                                        <MenuItem.Header>
                                                            <StackPanel Width="170" Margin="2">
                                                                <TextBlock Text="Transparency" FontSize="11" Foreground="#FFA0AAB5" Margin="0,0,0,4"/>
                                                                <DockPanel>
                                                                    <TextBox DockPanel.Dock="Right" Width="45" Margin="4,0,0,0" Text="{Binding OpacityPercent, StringFormat=\{0:F0\}, UpdateSourceTrigger=LostFocus}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" FontSize="11" VerticalAlignment="Center" />
                                                                    <Slider Minimum="0" Maximum="100" Value="{Binding OpacityPercent}" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsVisible}" DockPanel.Dock="Left"
                                                          VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        Background="Transparent" BorderThickness="0" Foreground="#888"
                                                        Padding="3,0" VerticalAlignment="Center" Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteSegmentItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Delete" />
                                                <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BgDarkBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- ═══ CENTER: 3D VIEWPORT ═══ -->
            <Border Grid.Column="2" Margin="4" Background="{StaticResource BgMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Viewport toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4">
                        <CheckBox Content="Ortho" IsChecked="{Binding IsOrthographic}"
                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                  Margin="0,0,12,0"
                                  Checked="OnProjectionChanged" Unchecked="OnProjectionChanged" />
                        <CheckBox IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                  Margin="0" VerticalAlignment="Center"
                                  Checked="OnGridToggled" Unchecked="OnGridToggled" />

                        <CheckBox x:Name="GridDragButton" Content="Grid"
                                  FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"
                                  IsEnabled="{Binding ShowGrid}"
                                  ContextMenuService.Placement="Bottom"
                                  Checked="OnGridDragToggled" Unchecked="OnGridDragToggled">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" 
                                                           VerticalAlignment="Center" Cursor="Hand" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="txt" Property="Foreground" Value="#FF1B98E0" />
                                                    </Trigger>
                                                    <!-- Overriding global IsEnabled trigger implicitly by providing a new Style/Template -->
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                            <CheckBox.ContextMenu>
                                <ContextMenu x:Name="GridContextMenu">
                                    <MenuItem Header="Set as new center" Click="SetAsNewCenter_Click" />
                                    <MenuItem Header="Recentre" Click="Recentre_Click" />
                                    <MenuItem Header="Reset" Click="Reset_Click" />
                                </ContextMenu>
                            </CheckBox.ContextMenu>
                        </CheckBox>
                    </StackPanel>

                    <!-- 3D Viewport. ShowViewCube="False" = custom NavCube active.
                         To revert to built-in: change ShowViewCube to True and set NavCube Visibility=Collapsed below. -->
                    <Border x:Name="ViewportHostBorder" Grid.Row="1">
                        <hx:Viewport3DX x:Name="Viewport3D"
                                    BackgroundColor="#FF0C1018"
                                    ShowCoordinateSystem="True"
                                    CoordinateSystemLabelForeground="#00000000"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True"
                                    IsPanEnabled="True"
                                    IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball"
                                    ModelUpDirection="0,0,1"
                                    ShowViewCube="False"
                                    IsViewCubeEdgeClicksEnabled="True"
                                    IsInertiaEnabled="False"
                                    CoordinateSystemLabelX=""
                                    CoordinateSystemLabelY=""
                                    CoordinateSystemLabelZ="">
                        <hx:Viewport3DX.InputBindings>
                            <MouseBinding Gesture="MiddleClick" Command="hx:ViewportCommands.Pan" />
                        </hx:Viewport3DX.InputBindings>
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="MainCamera"
                                                  Position="0,-300,0" LookDirection="0,1,0"
                                                  UpDirection="0,0,1" FieldOfView="45"
                                                  NearPlaneDistance="0.1" FarPlaneDistance="10000" />
                        </hx:Viewport3DX.Camera>

                        <!-- Headlamp: direction set from code-behind, tracks camera -->
                        <hx:AmbientLight3D Color="#505050" />
                        <hx:DirectionalLight3D x:Name="MainHeadlamp" Direction="0,-1,0" Color="#D0D0D0" />
                        <hx:DirectionalLight3D x:Name="MainBacklamp" Direction="0,1,0" Color="#A0A0A0" />

                        <!-- Live 3D Threshold Preview Proxy -->
                        <hx:MeshGeometryModel3D Geometry="{Binding LivePreviewGeometry}" 
                                                Material="{Binding LivePreviewMaterial}" 
                                                IsRendering="{Binding ShowBoneOverlay}" />

                        <!-- Direct Volume Rendering proxy for diffuse bone visualization -->
                        <ctrl:VolumeTextureModel3D VolumeNode="{Binding VolumeNode}" 
                                                   IsRendering="{Binding IsVolumeRenderingEnabled}" />

                        <hx:ItemsModel3D ItemsSource="{Binding Segments}">
                            <hx:ItemsModel3D.ItemTemplate>
                                <DataTemplate>
                                    <hx:MeshGeometryModel3D Geometry="{Binding Geometry}" Material="{Binding Material}" IsRendering="{Binding IsVisible}" Transform="{Binding Transform}" IsTransparent="{Binding IsTransparent}" />
                                </DataTemplate>
                            </hx:ItemsModel3D.ItemTemplate>
                        </hx:ItemsModel3D>
                        
                        <hx:ItemsModel3D ItemsSource="{Binding ImportedMeshes}">
                            <hx:ItemsModel3D.ItemTemplate>
                                <DataTemplate>
                                    <hx:MeshGeometryModel3D Geometry="{Binding Geometry}" Material="{Binding Material}" IsRendering="{Binding IsVisible}" Transform="{Binding Transform}" IsTransparent="{Binding IsTransparent}" />
                                </DataTemplate>
                            </hx:ItemsModel3D.ItemTemplate>
                        </hx:ItemsModel3D>
                    </hx:Viewport3DX>
                    </Border>

                    <!-- Reset Camera Button Group -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                        <Button Width="32" Height="32" Margin="0,0,4,0" Background="#80000000" BorderBrush="#40FFFFFF" Foreground="White"
                                Cursor="Hand" ToolTip="Reset Panning (Keep Rotation)" Click="CenterCamera_Click">
                            <Path Data="M 16,2 L 16,30 M 2,16 L 30,16 M 10,16 A 6,6 0 1,1 10.1,16" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Margin="6"/>
                        </Button>
                        <Button Width="32" Height="32" Margin="0,0,4,0" Background="#80000000" BorderBrush="#40FFFFFF" Foreground="White"
                                Cursor="Hand" ToolTip="Anterior View (Front)" Click="AnteriorView_Click">
                            <Path Data="M 10,26 L 22,26 L 22,20 C 28,18 28,6 16,6 C 4,6 4,18 10,20 Z M 12,12 A 2,2 0 1,1 12.1,12 M 20,12 A 2,2 0 1,1 20.1,12 M 16,18 L 16,20 M 14,26 L 14,21 M 18,26 L 18,21" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Margin="6"/>
                        </Button>
                        <Button Width="32" Height="32" Background="#80000000" BorderBrush="#40FFFFFF" Foreground="White"
                                Cursor="Hand" ToolTip="Right Profile View" Click="RightProfile_Click">
                            <Path Data="M 8,26 L 18,26 L 18,22 L 23,22 L 25,18 L 25,12 C 25,6 14,6 10,6 C 6,6 4,14 8,20 Z M 18,12 A 2,2 0 1,1 18.1,12 M 22,18 L 20,18" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Margin="6"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- Custom NavCube (Autodesk-style). Set Visibility=Collapsed to revert to built-in. -->
                    <ctrl:NavCubeControl x:Name="NavCube" Grid.Row="1"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,8,8" Opacity="0.92"
                                         Visibility="Visible" />

                    <!-- Grid overlay (drawn in code-behind) -->
                    <Canvas x:Name="GridOverlay" Grid.Row="1"
                            IsHitTestVisible="False" Visibility="Collapsed"
                            Background="Transparent"
                            MouseLeftButtonDown="GridOverlay_MouseDown"
                            MouseMove="GridOverlay_MouseMove"
                            MouseLeftButtonUp="GridOverlay_MouseUp" />

                    <!-- Enlarged MPR view overlay -->
                    <Border x:Name="EnlargedOverlay" Grid.Row="1" Background="#FF0C1018"
                            Visibility="Collapsed" Margin="0">
                        <Grid x:Name="EnlargedGrid" MouseWheel="EnlargedPanel_MouseWheel"
                              MouseLeftButtonDown="SlicePanel_LeftDown"
                              MouseRightButtonDown="SlicePanel_RightDown"
                              MouseRightButtonUp="SlicePanel_RightUp"
                              MouseMove="SlicePanel_MouseMove"
                              Background="Transparent">
                            <Image x:Name="EnlargedImage" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Canvas x:Name="EnlargedCrosshairCanvas" IsHitTestVisible="False" />
                            <TextBlock x:Name="EnlargedLabel" Style="{StaticResource PanelHeader}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="12,8" FontSize="14" />
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,12,0" Padding="6,2" FontSize="14" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="CloseEnlarged_Click" ToolTip="Close Enlarged View" />
                        </Grid>
                    </Border>
                    
                    <!-- Overlay: placeholder text when no data -->
                    <TextBlock Grid.Row="1" Text="Load a DICOM / CBCT folder to visualize"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsVolumeLoaded, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" Background="{StaticResource BgDarkBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- ═══ RIGHT: 3-TAB LAYOUT ═══ -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TAB HEADER -->
                <Border Grid.Row="0" Margin="4,4,4,0" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#FF3B4559">
                    <UniformGrid Columns="3" Margin="0">
                        <RadioButton Content="CT (MPR)" GroupName="RightTabs" IsChecked="{Binding RightPanelTabIndex, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=0}" Style="{StaticResource PanelTabButtonStyle}" FontSize="11" FontWeight="SemiBold" Margin="0,0,2,0"/>
                        <RadioButton Content="Measurements" GroupName="RightTabs" IsChecked="{Binding RightPanelTabIndex, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}" Style="{StaticResource PanelTabButtonStyle}" FontSize="11" FontWeight="SemiBold" Margin="2,0,2,0"/>
                        <RadioButton Content="Surgery" GroupName="RightTabs" IsChecked="{Binding RightPanelTabIndex, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=2}" Style="{StaticResource PanelTabButtonStyle}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,0"/>
                    </UniformGrid>
                </Border>

                <!-- TAB 0: CT MPR -->
                <Grid Grid.Row="1" Visibility="{Binding RightPanelTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding AxialDisplayHeight}" />
                        <RowDefinition Height="{Binding CoronalDisplayHeight}" />
                        <RowDefinition Height="{Binding SagittalDisplayHeight}" />
                    </Grid.RowDefinitions>

                    <!-- MPR Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,3">
                        <CheckBox Content="Crosshairs" IsChecked="{Binding ShowCrosshairs, Mode=TwoWay}"
                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                  Checked="OnCrosshairsToggled" Unchecked="OnCrosshairsToggled" />
                    </StackPanel>

                    <!-- Axial View -->
                    <Border Grid.Row="1" Margin="4" Background="{StaticResource BgMediumBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid x:Name="AxialPanel"
                              MouseWheel="AxialPanel_MouseWheel"
                              MouseLeftButtonDown="SlicePanel_LeftDown"
                              MouseRightButtonDown="SlicePanel_RightDown"
                              MouseRightButtonUp="SlicePanel_RightUp"
                              MouseMove="SlicePanel_MouseMove"
                              Background="Transparent">
                            <Image Source="{Binding AxialImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Canvas x:Name="AxialCrosshairCanvas" IsHitTestVisible="False" />
                            <TextBlock Text="AXIAL" Style="{StaticResource PanelHeader}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6" />
                            <Button Content="⤢" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,8,0" Padding="4,1" FontSize="12" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="EnlargeAxial_Click" ToolTip="Enlarge Axial" />
                        </Grid>
                    </Border>

                    <!-- Coronal View -->
                    <Border Grid.Row="2" Margin="4" Background="{StaticResource BgMediumBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid x:Name="CoronalPanel"
                              MouseWheel="CoronalPanel_MouseWheel"
                              MouseLeftButtonDown="SlicePanel_LeftDown"
                              MouseRightButtonDown="SlicePanel_RightDown"
                              MouseRightButtonUp="SlicePanel_RightUp"
                              MouseMove="SlicePanel_MouseMove"
                              Background="Transparent">
                            <Image Source="{Binding CoronalImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Canvas x:Name="CoronalCrosshairCanvas" IsHitTestVisible="False" />
                            <TextBlock Text="CORONAL" Style="{StaticResource PanelHeader}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6" />
                            <Button Content="⤢" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,8,0" Padding="4,1" FontSize="12" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="EnlargeCoronal_Click" ToolTip="Enlarge Coronal" />
                        </Grid>
                    </Border>

                    <!-- Sagittal View -->
                    <Border Grid.Row="3" Margin="4" Background="{StaticResource BgMediumBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid x:Name="SagittalPanel"
                              MouseWheel="SagittalPanel_MouseWheel"
                              MouseLeftButtonDown="SlicePanel_LeftDown"
                              MouseRightButtonDown="SlicePanel_RightDown"
                              MouseRightButtonUp="SlicePanel_RightUp"
                              MouseMove="SlicePanel_MouseMove"
                              Background="Transparent">
                            <Image Source="{Binding SagittalImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Canvas x:Name="SagittalCrosshairCanvas" IsHitTestVisible="False" />
                            <TextBlock Text="SAGITTAL" Style="{StaticResource PanelHeader}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6" />
                            <Button Content="⤢" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,8,0" Padding="4,1" FontSize="12" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="EnlargeSagittal_Click" ToolTip="Enlarge Sagittal" />
                        </Grid>
                    </Border>
