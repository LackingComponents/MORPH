                                                                        </ContextMenu>
                                                                    </DockPanel.ContextMenu>
                                                                    <!-- "＋ Plan" button on the right — saves current movements as a new plan -->
                                                                    <Button DockPanel.Dock="Right" Content="＋ Plan"
                                                                            Height="16" FontSize="9" Padding="5,0"
                                                                            Background="#30FFFFFF" BorderThickness="0"
                                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                                            VerticalAlignment="Center" Cursor="Hand"
                                                                            Command="{Binding Tag.AddPlanCommand, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <!-- Active indicator + name -->
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="#FF505060"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                            <Setter Property="Fill" Value="#FF1B98E0"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Expander.Header>

                                                            <!-- Plan rows inside the expander -->
                                                            <StackPanel Margin="8,4,0,0">
                                                                <ItemsControl ItemsSource="{Binding Plans}"
                                                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,1" CornerRadius="3" Padding="4,3" Cursor="Hand">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="#10FFFFFF"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="Background" Value="#35268BBD"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <DockPanel Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                                                    <!-- 💾 overwrites this plan with current movements -->
                                                                                    <Button DockPanel.Dock="Right" Content="💾"
                                                                                            ToolTip="Overwrite with current movements"
                                                                                            Background="Transparent" BorderThickness="0"
                                                                                            Foreground="#80FFFFFF" FontSize="10" Padding="4,0" Cursor="Hand"
                                                                                            Command="{Binding Tag.SavePlanCommand, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                                            CommandParameter="{Binding}"/>
                                                                                    <!-- Click row to select and apply plan -->
                                                                                    <Button Background="Transparent" BorderThickness="0"
                                                                                            HorizontalContentAlignment="Left" Padding="0"
                                                                                            Foreground="{StaticResource TextPrimaryBrush}" FontSize="10"
                                                                                            Command="{Binding Tag.SelectPlanCommand, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                                                                                            CommandParameter="{Binding}">
                                                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                                                    </Button>
                                                                                </DockPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Add Occlusion: load new STL + open alignment wizard -->
                                            <Button Margin="0,6,0,0" Height="22" FontSize="10" FontWeight="SemiBold"
                                                    Content="＋  Add Occlusion"
                                                    Background="#FF1B98E0" BorderThickness="0" Foreground="White"
                                                    Command="{Binding AddOcclusionNodeCommand}"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══ FULLSCREEN PHOTOGRAMMETRY OVERLAY ═══ -->
            <Border Grid.Column="2" Grid.ColumnSpan="3" Background="#E50C1018"
                    Visibility="{Binding IsPhotogrammetryOpen, Converter={StaticResource BoolToVisibility}}"
                    Margin="-4,0,0,0">
                <v:PhotogrammetryView DataContext="{Binding PhotogrammetrySpace}" />
            </Border>

            <!-- ═══ FULLSCREEN CEPHALOMETRY OVERLAY ═══ -->
            <Border Grid.Column="2" Grid.ColumnSpan="3" Background="#E50C1018"
                    Visibility="{Binding IsCephalometryOpen, Converter={StaticResource BoolToVisibility}}"
                    Margin="-4,0,0,0">
                <local:CephalometryWindow x:Name="CephalometryPanel" />
            </Border>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="{Binding VolumeDimensions}" Style="{StaticResource StatusText}"
                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <ProgressBar Value="{Binding LoadProgress}" Maximum="100"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             Margin="20,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
