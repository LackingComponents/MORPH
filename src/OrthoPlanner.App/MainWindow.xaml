<Window x:Class="OrthoPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:vm="clr-namespace:OrthoPlanner.App.ViewModels"
        xmlns:ctrl="clr-namespace:OrthoPlanner.App.Controls"
        xmlns:v="clr-namespace:OrthoPlanner.App.Views"
        xmlns:local="clr-namespace:OrthoPlanner.App"
        xmlns:cv="clr-namespace:OrthoPlanner.App.Converters"
        Title="OrthoPlanner — Orthognathic Surgery Planning"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Style="{StaticResource MainWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <cv:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <Style x:Key="PanelTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFA0AAB5" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2B3240" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3B4559" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF424D63" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF30343D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF404552" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E80B4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="GearToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BgLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ TOP TOOLBAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <!-- App Logo (click for project menu) -->
                <Button DockPanel.Dock="Left" Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand" Click="LogoMenu_Click" ToolTip="Project Menu">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⬡" FontSize="22" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="ORTHO" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="PLANNER" FontSize="16" FontWeight="Light"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" ▾" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="4,2,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProjectMenu">
                            <MenuItem Header="📂  New Project" Command="{Binding OpenDicomFolderCommand}" />
                            <MenuItem Header="📁  Open Project" Command="{Binding OpenProjectCommand}" />
                            <Separator />
                            <MenuItem Header="💾  Save Project" Command="{Binding SaveProjectCommand}" />
                            <Separator />
                            <MenuItem Header="👁️  View" Margin="0,2,0,0">
                                <MenuItem Header="💡 Configure Lighting..." Command="{Binding OpenLightingConfigCommand}" />
                            </MenuItem>
                            <MenuItem Header="📤  Export STLs" Command="{Binding ExportStlCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Toolbar Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="16,0,0,0">
                    <Button Content="💾 Save" Command="{Binding SaveProjectCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                            Cursor="Hand" Padding="8,4" Margin="4,0" ToolTip="Save Project (Ctrl+S)" />
                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="4,6" />
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                            Cursor="Hand" Padding="8,4" Margin="4,0" ToolTip="Undo Action (Ctrl+Z)" />
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                            Cursor="Hand" Padding="8,4" Margin="4,0" ToolTip="Redo Action (Ctrl+Y)" />
                </StackPanel>

                <!-- Right-side patient info -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    
                    <!-- NHP Button & Popup -->
                    <ToggleButton x:Name="NhpToggleButton" Content="✛ NHP" Margin="0,0,16,0" Padding="8,4" 
                                  VerticalAlignment="Center" FontWeight="SemiBold"
                                  Style="{StaticResource DarkToggleButtonStyle}" />
                    <Popup IsOpen="{Binding IsChecked, ElementName=NhpToggleButton, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=NhpToggleButton}" Placement="Bottom" VerticalOffset="4">
                        <Border Background="#FF21252B" BorderBrush="#FF30343D" BorderThickness="1" CornerRadius="4" Padding="12" Width="220">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style x:Key="DarkStepperButtonStyle" TargetType="Button">
                                        <Setter Property="Background" Value="#FF30343D" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Width" Value="24" />
                                        <Setter Property="Height" Value="24" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    
                                    <Style x:Key="VerticalStepperButtonStyle" TargetType="RepeatButton">
                                        <Setter Property="Background" Value="#FF30343D" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Width" Value="20" />
                                        <Setter Property="Height" Value="12" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FontSize" Value="8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="1">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>
                                
                                <TextBlock Text="NATURAL HEAD POSITION" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                                
                                <!-- Translations -->
                                <TextBlock Text="Translations (mm)" Foreground="#FFA0AAB5" FontSize="10" Margin="0,0,0,4" />
                                
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Lateral (X):" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Width="50" Text="{Binding NhpLateral, StringFormat={}{0:F1}}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" Margin="0,0,4,0" VerticalAlignment="Center" PreviewKeyDown="NhpTextBox_PreviewKeyDown" Tag="Lat"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <RepeatButton Content="▲" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Lat+" Margin="0,0,0,1"/>
                                            <RepeatButton Content="▼" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Lat-"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Anterior (Y):" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Width="50" Text="{Binding NhpAnteroposterior, StringFormat={}{0:F1}}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" Margin="0,0,4,0" VerticalAlignment="Center" PreviewKeyDown="NhpTextBox_PreviewKeyDown" Tag="Ant"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <RepeatButton Content="▲" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Ant+" Margin="0,0,0,1"/>
                                            <RepeatButton Content="▼" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Ant-"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vertical (Z):" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Width="50" Text="{Binding NhpVertical, StringFormat={}{0:F1}}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" Margin="0,0,4,0" VerticalAlignment="Center" PreviewKeyDown="NhpTextBox_PreviewKeyDown" Tag="Vert"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <RepeatButton Content="▲" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Vert+" Margin="0,0,0,1"/>
                                            <RepeatButton Content="▼" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Vert-"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Rotations -->
                                <TextBlock Text="Rotations (°)" Foreground="#FFA0AAB5" FontSize="10" Margin="0,0,0,4" />
                                
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pitch (X):" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Width="50" Text="{Binding NhpPitch, StringFormat={}{0:F1}}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" Margin="0,0,4,0" VerticalAlignment="Center" PreviewKeyDown="NhpTextBox_PreviewKeyDown" Tag="Pitch"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <RepeatButton Content="▲" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Pitch+" Margin="0,0,0,1"/>
                                            <RepeatButton Content="▼" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Pitch-"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Roll (Y):" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Width="50" Text="{Binding NhpRoll, StringFormat={}{0:F1}}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" Margin="0,0,4,0" VerticalAlignment="Center" PreviewKeyDown="NhpTextBox_PreviewKeyDown" Tag="Roll"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <RepeatButton Content="▲" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Roll+" Margin="0,0,0,1"/>
                                            <RepeatButton Content="▼" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Roll-"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Yaw (Z):" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Width="50" Text="{Binding NhpYaw, StringFormat={}{0:F1}}" TextAlignment="Center" Background="#FF30343D" Foreground="White" BorderThickness="0" Margin="0,0,4,0" VerticalAlignment="Center" PreviewKeyDown="NhpTextBox_PreviewKeyDown" Tag="Yaw"/>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <RepeatButton Content="▲" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Yaw+" Margin="0,0,0,1"/>
                                            <RepeatButton Content="▼" Style="{StaticResource VerticalStepperButtonStyle}" Command="{Binding AdjustNhpCommand}" CommandParameter="Yaw-"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="#FF30343D" Margin="0,0,0,12"/>

                                <Button Content="DONE" Command="{Binding CommitNhpCommand}" 
                                        IsEnabled="{Binding IsNhpDirty}"
                                        Background="#FF1E80B4" Foreground="White" FontWeight="Bold" Padding="0,6" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Patient Metadata Button & Popup -->
                    <ToggleButton x:Name="MetadataToggleButton" Cursor="Hand" Margin="0,0,16,0" Padding="4" ToolTip="View DICOM Metadata">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PatientName}" Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StudyDate}" Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=MetadataToggleButton, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=MetadataToggleButton}" Placement="Bottom" VerticalOffset="4">
                        <Border Background="#FF21252B" BorderBrush="#FF30343D" BorderThickness="1" CornerRadius="4" Padding="12" Width="280">
                            <StackPanel>
                                <TextBlock Text="PATIENT INFORMATION" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                                
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Name:" Foreground="#FFA0AAB5" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                                
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Date of Birth:" Foreground="#FFA0AAB5" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding PatientDOB}" Foreground="White" FontSize="11" />
                                </Grid>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Study Date:" Foreground="#FFA0AAB5" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding StudyDate}" Foreground="White" FontSize="11" />
                                </Grid>

                                <TextBlock Text="SCAN PARAMETERS" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Description:" Foreground="#FFA0AAB5" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding SeriesDescription}" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                                
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Dimensions:" Foreground="#FFA0AAB5" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding VolumeDimensions}" Foreground="White" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <TextBlock />
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: WORKFLOW SIDEBAR ═══ -->
            <Border Grid.Column="0" Margin="4" Background="{StaticResource BgMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="6,4">
                        <StackPanel>

                            <!-- 1. SEGMENTATION -->
                            <Expander IsExpanded="True" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="F0 M 12,2 A 9,9 0 0 0 3,11 C 3,13.86 4.34,16.4 6.4,18.07 L 6,20.47 A 1,1 0 0 0 6.98,21.64 H 17.02 A 1,1 0 0 0 18,20.47 L 17.6,18.07 C 19.66,16.4 21,13.86 21,11 A 9,9 0 0 0 12,2 Z M 9,10 A 1.5,1.5 0 1 1 9,13 A 1.5,1.5 0 0 1 9,10 Z M 15,10 A 1.5,1.5 0 1 1 15,13 A 1.5,1.5 0 0 1 15,10 Z M 10.5,15.5 L 12,13.5 L 13.5,15.5 Z M 8,18 H 16 V 20 H 8 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="Segmentation" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="4,6,4,4">
                                    <!-- 1. BONE SEGMENTATION -->
                                <Expander Header="🦴  Bone Model" IsExpanded="True" Margin="0,2" Expanded="SingleExpanderOnly_Expanded"
                                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                                    <StackPanel Margin="4,6,4,4">
                                        <TextBlock Text="BONE THRESHOLD (HU)" Style="{StaticResource PanelHeader}" FontSize="9" />
                                        <Border Margin="0,4,0,2" CornerRadius="3" ClipToBounds="True" Background="#FF101418" Height="60">
                                            <Image Source="{Binding BoneHistogramImage}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <ctrl:RangeSlider Minimum="{Binding IsoMin}" Maximum="{Binding IsoMax}" Height="20"
                                                          LowerValue="{Binding BoneMinHU, Mode=TwoWay}" UpperValue="{Binding BoneMaxHU, Mode=TwoWay}" />
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBox Width="45" FontSize="9" TextAlignment="Center" Padding="2,0" VerticalContentAlignment="Center" Text="{Binding BoneMinHU, UpdateSourceTrigger=LostFocus}" />
                                            <TextBox DockPanel.Dock="Right" Width="45" FontSize="9" TextAlignment="Center" HorizontalAlignment="Right" Padding="2,0" VerticalContentAlignment="Center"
                                                     Text="{Binding BoneMaxHU, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock />
                                        </DockPanel>
                                        <CheckBox Content="Preview Overlay / Live Proxy" IsChecked="{Binding ShowBoneOverlay}"
                                                  Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                        <CheckBox Content="Bone Diffused View" IsChecked="{Binding IsVolumeRenderingEnabled}"
                                                  Visibility="Collapsed" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                        <CheckBox Content="Enhance Segmentation" IsChecked="{Binding EnhanceSegmentation}"
                                                  Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Compute Model" Command="{Binding RunBoneSegmentCommand}"
                                                    IsEnabled="{Binding IsVolumeLoaded}" Margin="0,0,4,0"/>
                                            <ToggleButton Grid.Column="1" x:Name="BoneOptionsToggle" Width="28" Height="28" Padding="0"
                                                          Style="{StaticResource GearToggleButtonStyle}" IsEnabled="{Binding IsVolumeLoaded}">
