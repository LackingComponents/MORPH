                                                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4"
                                                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                                  HorizontalContentAlignment="Stretch">
                                                            <Expander.Header>
                                                                <!-- Tag = MainViewModel so ContextMenu can reach commands -->
                                                                <DockPanel LastChildFill="True"
                                                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
