<UserControl x:Class="OrthoPlanner.App.Views.CephalometryOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:OrthoPlanner.App.Controls"
        Background="{x:Null}"
        Foreground="#FFD0D8E0"
        FontFamily="Segoe UI"
        FontSize="12"
        Focusable="True">

    <UserControl.Resources>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1E2D3D"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3A5A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#FFD0D8E0"
                                                      StrokeThickness="1.5" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" Margin="0,1,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="#1E2D3D"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <SolidColorBrush Color="#3A5A7A"/>
                                </ToggleButton.BorderBrush>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,3,24,3" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FF1E2D3D" BorderBrush="#FF3A5A7A"
                                        BorderThickness="1" CornerRadius="0,0,3,3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF1E2D3D"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A4A6B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A4A6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF1E2D3D"/>
            <Setter Property="Foreground" Value="#FFD0D8E0"/>
            <Setter Property="BorderBrush" Value="#FF3A5A7A"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A4A6B"/>
                                <Setter Property="Foreground" Value="#FF00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF253A50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CephAnalysisTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#FF151B23"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="#FF151B23">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="#FF151B23"/>
                            <Border Grid.Row="1" Background="#FF151B23" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CephAnalysisTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFD0D8E0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd" Background="#FF1E2D3D" Margin="0,0,2,0" Padding="12,5"
                                BorderBrush="#FF3A5A7A" BorderThickness="1" CornerRadius="3,3,0,0">
                            <ContentPresenter x:Name="HeaderText" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#FFD0D8E0" TextElement.FontSize="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#FF2A4A6B"/>
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="#FF3A5A7A"/>
                                <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="Bold"/>
                                <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#FF253A50"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBd" Property="Background" Value="#FF2A4A6B"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CephAnalysisDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#FF151B23"/>
            <Setter Property="Foreground" Value="#FFD0D8E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#10FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="RowHeight" Value="22"/>
        </Style>
        <Style x:Key="CephAnalysisColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1E2730"/>
            <Setter Property="Foreground" Value="#FF6E7F90"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="BorderBrush" Value="#FF232E3A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="CephAnalysisCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD0D8E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Foreground" Value="#FF6E7F90"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutOfNorm}" Value="True">
                    <Setter Property="Foreground" Value="#FFFF8A65"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CephAnalysisValueText" TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMissing}" Value="False"/>
                        <Condition Binding="{Binding IsOutOfNorm}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FF00E5FF"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- == Toolbars == -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <!-- Row 1: View controls -->
            <Border Background="#FF151B23" Height="34"
                    BorderThickness="0,0,0,1" BorderBrush="#FF232E3A">
                <DockPanel VerticalAlignment="Center" Margin="8,0">
                    <ToggleButton DockPanel.Dock="Right" x:Name="Btn3DToggle"
                                  Content="3D" Style="{StaticResource DarkToggleButton}"
                                  Margin="4,0,0,0"
                                  Checked="Toggle3D_Changed" Unchecked="Toggle3D_Changed"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="ChkOrtho" Content="Ortho"
                              IsChecked="{Binding IsOrthographic}"
                              Foreground="#FFD0D8E0" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                              IsEnabled="{Binding IsChecked, ElementName=Btn3DToggle}"
                              Checked="ChkOrtho_Changed" Unchecked="ChkOrtho_Changed"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Projection:" Foreground="#FF6E7F90" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                        <ComboBox x:Name="CmbProjection" Width="100" SelectedIndex="0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  SelectionChanged="CmbProjection_SelectionChanged"/>
                        <Rectangle Width="1" Fill="#FF232E3A" Margin="10,6"/>
                        <CheckBox x:Name="ChkInvert" Content="Invert (I)" IsChecked="True"
                                  Foreground="#FFD0D8E0" VerticalAlignment="Center"
                                  Checked="ChkInvert_Changed" Unchecked="ChkInvert_Changed"/>
                        <Rectangle Width="1" Fill="#FF232E3A" Margin="10,6"/>
                        <CheckBox x:Name="ChkShowGrid" Content="Grid"
                                  Foreground="#FFD0D8E0" FontSize="11" VerticalAlignment="Center"
                                  Checked="ChkShowGrid_Changed" Unchecked="ChkShowGrid_Changed"/>
                        <ToggleButton x:Name="BtnGridDrag" Content="Move Grid"
                                      Style="{StaticResource DarkToggleButton}"
                                      Margin="6,0,0,0" FontSize="10" IsEnabled="False"
                                      ToolTip="Drag to reposition the grid. Right-click for center options."
                                      Checked="BtnGridDrag_Changed" Unchecked="BtnGridDrag_Changed">
                            <ToggleButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Set as new center" Click="CephGrid_SetCenter_Click"/>
                                    <MenuItem Header="Recentre" Click="CephGrid_Recentre_Click"/>
                                    <MenuItem Header="Reset" Click="CephGrid_Reset_Click"/>
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                        </ToggleButton>
                        <Rectangle Width="1" Fill="#FF232E3A" Margin="10,6"/>
                        <Button Content="Edit NHP" Padding="8,3" Margin="2,0"
                                Click="EditNhp_Click"
                                ToolTip="Adjust Natural Head Position while keeping cephalometric geometry attached"/>
                        <Button Content="Reset Ceph" Padding="8,3" Margin="2,0" Click="ResetView_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Row 2: Measurement tools -->
            <Border Background="#FF131920" Height="30"
                    BorderThickness="0,0,0,1" BorderBrush="#FF232E3A">
                <StackPanel x:Name="ToolButtonPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button x:Name="BtnToolSelect"   Content="Select"    Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="Select"/>
                    <Button x:Name="BtnToolPoint"    Content="Point"     Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="CustomPoint"/>
                    <Button x:Name="BtnToolLine"     Content="Line"      Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="Line"/>
                    <Button x:Name="BtnToolPlane"    Content="Plane"     Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="InfinitePlane"/>
                    <Button x:Name="BtnAddFrankfort" Content="FH Plane"  Padding="6,2" Margin="1,0" FontSize="10" Click="AddFrankfortPlane_Click"/>
                    <Rectangle Width="1" Fill="#FF232E3A" Margin="4,4"/>
                    <Button x:Name="BtnToolAngPlane" Content="&#x2220; Planes" Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="AnglePlanes"/>
                    <Button x:Name="BtnToolAng3"     Content="&#x2220; 3pts"   Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="Angle3Points"/>
                    <Rectangle Width="1" Fill="#FF232E3A" Margin="4,4"/>
                    <Button x:Name="BtnToolDistPts"  Content="&#x2194; mm"     Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="DistancePoints"/>
                    <Button x:Name="BtnToolDistPln"  Content="&#x22A5; dist"   Padding="6,2" Margin="1,0" FontSize="10" Click="ToolBtn_Click" Tag="DistancePointPlane"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- == Viewport Area: DRR 2D overlay + 3D pass-through area ==
             In 3D navigation mode: ViewportBorder is collapsed and this Grid becomes
             mouse-transparent, so the live HelixViewport3D in MainWindow receives its
             native rotate/pan/zoom controls. In placement mode it becomes hit-testable
             again so clicks can be ray-cast into the shared MainViewport. -->
        <Grid Grid.Row="1" Grid.Column="0" x:Name="ViewportGrid" Background="Transparent">
            <!-- DRR 2D Panel (overlay; Collapsed when 3D mode is active) -->
            <Border x:Name="ViewportBorder" Background="#FF000000" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="ImageCanvas"
                            MouseWheel="ImageCanvas_MouseWheel"
                            MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="ImageCanvas_MouseLeftButtonUp"
                            MouseRightButtonDown="ImageCanvas_MouseRightButtonDown"
                            MouseRightButtonUp="ImageCanvas_MouseRightButtonUp"
                            MouseDown="ImageCanvas_MouseDown"
                            MouseUp="ImageCanvas_MouseUp"
                            MouseMove="ImageCanvas_MouseMove"
                            Background="Transparent">
                        <Image x:Name="DrrImageControl"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="None"/>
                        <Canvas x:Name="MeasurementsCanvas"/>
                        <Canvas x:Name="LandmarkCanvas"/>
                    </Canvas>

                    <!-- W/L Live HUD - always visible, updates during right-drag -->
                    <Border x:Name="WlHud"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#BB000C18" CornerRadius="6"
                            Padding="12,8" Margin="0,8,8,0"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock x:Name="WlHudW" Text="W  1.140"
                                       Foreground="#00E5FF" FontFamily="Consolas"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WlHudL" Text="L  0.584"
                                       Foreground="#00E5FF" FontFamily="Consolas"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Magnifier Loupe - top-left, 2x zoom of area under cursor -->
                    <Border x:Name="LoupePanel"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="380" Height="300"
                            Background="#CC000C18" CornerRadius="6"
                            BorderBrush="#FF3A5A7A" BorderThickness="1"
                            Margin="8,8,0,0"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Grid>
                            <Rectangle x:Name="LoupeRect" RadiusX="5" RadiusY="5"/>
                            <!-- Thin white X crosshair -->
                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20">
                                <Line X1="0" Y1="0" X2="20" Y2="20" Stroke="White" StrokeThickness="1" Opacity="0.8"/>
                                <Line X1="20" Y1="0" X2="0" Y2="20" Stroke="White" StrokeThickness="1" Opacity="0.8"/>
                            </Canvas>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="#AA1E4A8A" CornerRadius="3"
                                    Padding="5,2" Margin="0,0,5,5">
                                <TextBlock Text="2x" Foreground="#FFD0D8E0"
                                           FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Consolas"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Screen-space reference grid — on top in 2D and 3D. Mouse-transparent unless
                 the "Move Grid" toggle enables hit-testing for dragging. -->
            <Canvas x:Name="CephGridOverlay" ClipToBounds="True"
                    Background="Transparent"
                    IsHitTestVisible="False" Visibility="Collapsed"
                    MouseLeftButtonDown="CephGridOverlay_MouseLeftButtonDown"
                    MouseMove="CephGridOverlay_MouseMove"
                    MouseLeftButtonUp="CephGridOverlay_MouseLeftButtonUp"/>
        </Grid>

        <!-- == Sidebar (Landmarks + Analysis + Custom tools) == -->
        <Border Grid.Row="1" Grid.Column="1" Background="#FF151B23"
                BorderThickness="1,0,0,0" BorderBrush="#FF232E3A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF1E2730" Padding="10,7"
                        BorderThickness="0,0,0,1" BorderBrush="#FF232E3A">
                    <TextBlock Text="LANDMARKS" Foreground="#FF6E7F90" FontSize="10" FontWeight="SemiBold"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel x:Name="LandmarkListPanel" Margin="0,4"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#FF1E2730" Padding="10,7"
                        BorderThickness="0,1,0,1" BorderBrush="#FF232E3A">
                    <DockPanel DataContext="{Binding ElementName=AnalysisTabControl}">
                        <TextBlock Text="ANALYSIS" Foreground="#FF6E7F90" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusNote}"
                                   Foreground="#FF6E7F90" FontSize="9" FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <TabControl Grid.Row="3" x:Name="AnalysisTabControl"
                            Style="{StaticResource CephAnalysisTabControl}"
                            ItemContainerStyle="{StaticResource CephAnalysisTabItem}"
                            Padding="0" Margin="0">
                    <TabItem Header="Steiner">
                        <DataGrid ItemsSource="{Binding SteinerRows}"
                                  Style="{StaticResource CephAnalysisDataGrid}"
                                  ColumnHeaderStyle="{StaticResource CephAnalysisColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Meas" Binding="{Binding Abbreviation}" Width="52">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="58">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisValueText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Norm" Binding="{Binding NormText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Δ" Binding="{Binding DeviationText}" Width="36">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Tweed">
                        <DataGrid ItemsSource="{Binding TweedRows}"
                                  Style="{StaticResource CephAnalysisDataGrid}"
                                  ColumnHeaderStyle="{StaticResource CephAnalysisColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Meas" Binding="{Binding Abbreviation}" Width="52">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="58">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisValueText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Norm" Binding="{Binding NormText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Δ" Binding="{Binding DeviationText}" Width="36">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Ricketts">
                        <DataGrid ItemsSource="{Binding RickettsRows}"
                                  Style="{StaticResource CephAnalysisDataGrid}"
                                  ColumnHeaderStyle="{StaticResource CephAnalysisColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Meas" Binding="{Binding Abbreviation}" Width="52">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="58">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisValueText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Norm" Binding="{Binding NormText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Δ" Binding="{Binding DeviationText}" Width="36">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CephAnalysisCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="4" Background="#FF1E2730" Padding="10,7"
                        BorderThickness="0,1,0,1" BorderBrush="#FF232E3A">
                    <TextBlock Text="CUSTOM TOOLS" Foreground="#FF6E7F90" FontSize="10" FontWeight="SemiBold"/>
                </Border>

                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel x:Name="MeasurementListPanel" Margin="0,4"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- == Status Bar == -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FF151B23" Height="22"
                BorderThickness="0,1,0,0" BorderBrush="#FF232E3A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLeft" Grid.Column="0" Text="Ready"
                           Foreground="#FFD0D8E0" VerticalAlignment="Center" Margin="10,0" FontSize="10"/>
                <TextBlock x:Name="StatusCenter" Grid.Column="1" Foreground="#FF6E7F90"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                <TextBlock x:Name="StatusRight" Grid.Column="2" Foreground="#FF6E7F90"
                           VerticalAlignment="Center" Margin="10,0" FontSize="10"/>
            </Grid>
        </Border>

        <!-- == Loading overlay == -->
        <Grid x:Name="LoadingOverlay" Grid.Row="1" Grid.ColumnSpan="2"
              Visibility="Collapsed" Background="#CC000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="LoadingProgress" Width="280" Height="4"
                             IsIndeterminate="True" Foreground="#FF6B8DAF" Background="#FF232E3A"/>
                <TextBlock x:Name="LoadingText" Text="Generating DRR..."
                           Foreground="#FFD0D8E0" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
