<UserControl x:Class="OrthoPlanner.App.Views.PhotogrammetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:OrthoPlanner.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#FF0C1018">

    <UserControl.Resources>
        <BooleanToVisibilityConverter    x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />          <!-- Visible when NULL  -->
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />  <!-- Visible when NOT NULL -->
        <conv:EnumToBoolConverter        x:Key="EnumToBool" />

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#FF8A9BB0"/>
            <Setter Property="FontSize"    Value="9"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,8,0,4"/>
        </Style>

        <!-- Dark ComboBox items that stay readable in WPF default theming -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"            Value="#FF1A1F28"/>
            <Setter Property="Foreground"            Value="#FFCDD3DC"/>
            <Setter Property="BorderBrush"           Value="#FF2D3340"/>
            <Setter Property="BorderThickness"       Value="1"/>
            <Setter Property="Padding"               Value="6,4"/>
            <Setter Property="Margin"                Value="0,0,0,6"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground"  Value="#FFCDD3DC"/>
                        <Setter Property="Background"  Value="#FF1A1F28"/>
                        <Setter Property="Padding"     Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E3A52"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF1B6EA0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar RadioButton (tool selector) -->
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#FFCDD3DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF282C38"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E6EA0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1B98E0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact action button for sidebar -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FF1E2530"/>
            <Setter Property="Foreground"      Value="#FFCDD3DC"/>
            <Setter Property="BorderBrush"     Value="#FF2D3340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0,5"/>
            <Setter Property="Margin"          Value="0,0,0,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF283040"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════ LEFT SIDEBAR (always visible) ═══════════════════════ -->
        <Border Grid.Column="0" Background="#FF161B22"
                BorderBrush="#FF2D3340" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="*"/>     <!-- Thumbnails -->
                    <RowDefinition Height="Auto"/>  <!-- Load button -->
                    <!-- Active photo props — fixed below thumbnails, always takes its space -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="12,10" BorderBrush="#FF2D3340" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="📷 PHOTOGRAMMETRY" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Load and analyse facial photographs."
                                   Foreground="#FF607080" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Thumbnails -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,0">
                    <ItemsControl ItemsSource="{Binding Photos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Margin="0,0,0,6" Padding="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"   Value="#FF1A1F28"/>
                                            <Setter Property="BorderBrush"  Value="#FF2D3340"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF1B98E0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                Command="{Binding DataContext.SetActivePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <!-- Wrap in fixed-size container so 90° rotated photos still fit the thumbnail slot -->
                                            <Border Width="110" Height="110" Background="Transparent" ClipToBounds="True">
                                                <Image Source="{Binding ImageSource}" Stretch="Uniform"
                                                       MaxWidth="140" MaxHeight="140"
                                                       RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="{Binding RotationAngle}"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Border>
                                        </Button>
                                        <DockPanel Grid.Row="1" Margin="2,4,2,0">
                                            <Button DockPanel.Dock="Right" Content="✕"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#FF607080" Padding="3,0" Cursor="Hand"
                                                    Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#FFAAB4C0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Load Button -->
                <Button Grid.Row="2" Content="＋  Load Photos…" Command="{Binding LoadPhotosCommand}"
                        Background="#FF1B98E0" Foreground="White" FontWeight="Bold"
                        Margin="8,8,8,4" Padding="0,8" BorderThickness="0" Cursor="Hand"/>

                <!-- ─── Active Photo Properties (visible when a photo is selected) ─── -->
                <Border Grid.Row="3" BorderBrush="#FF2D3340" BorderThickness="0,1,0,0"
                        Visibility="{Binding ActivePhoto, Converter={StaticResource NotNullToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <StackPanel Margin="10,6,10,12" DataContext="{Binding ActivePhoto}">

                            <!-- Quick actions row -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="↻ Rotate 90°"
                                        Command="{Binding Rotate90Command}"
                                        Style="{StaticResource SideBtn}"/>
                                <Button Grid.Column="2" Content="⊡ Fit Screen"
                                        Command="{Binding ResetViewCommand}"
                                        Style="{StaticResource SideBtn}"/>
                            </Grid>

                            <!-- Category -->
                            <TextBlock Text="ANGLE" Style="{StaticResource SectionLabel}"/>
                            <ComboBox Style="{StaticResource DarkCombo}" SelectedIndex="{Binding CategoryIndex}">
                                <ComboBoxItem Content="Uncategorized"/>
                                <ComboBoxItem Content="Frontal"/>
                                <ComboBoxItem Content="Profile"/>
                                <ComboBoxItem Content="Three Quarter"/>
                                <ComboBoxItem Content="Intraoral"/>
                                <ComboBoxItem Content="Occlusal"/>
                            </ComboBox>

                            <!-- Expression -->
                            <TextBlock Text="EXPRESSION" Style="{StaticResource SectionLabel}"/>
                            <ComboBox Style="{StaticResource DarkCombo}" SelectedIndex="{Binding ExpressionIndex}">
                                <ComboBoxItem Content="Uncategorized"/>
                                <ComboBoxItem Content="Neutral"/>
                                <ComboBoxItem Content="Smile"/>
                                <ComboBoxItem Content="Dynamic"/>
                            </ComboBox>

                            <!-- Scale status -->
                            <TextBlock Text="SCALE" Style="{StaticResource SectionLabel}"/>
                            <DockPanel>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVis}}">
                                    <Ellipse.Fill><SolidColorBrush Color="#FF4CAF50"/></Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FFFF8C42"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNormalized}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFFF8C42"/>
                                            <Setter Property="Text" Value="Not calibrated"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNormalized}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                    <Setter Property="Text" Value="Calibrated"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding PixelsPerMm, StringFormat={}  ({0:F1} px/mm)}"
                                           Foreground="#FF607080" FontSize="10" VerticalAlignment="Center"
                                           Visibility="{Binding IsNormalized, Converter={StaticResource BoolToVis}}"/>
                            </DockPanel>

                            <!-- Measurements -->
                            <TextBlock Text="MEASUREMENTS" Style="{StaticResource SectionLabel}"/>
                            <ItemsControl ItemsSource="{Binding Measurements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF1A1F28" CornerRadius="3" Margin="0,0,0,3" Padding="6,4">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DistanceMm, StringFormat={}{0:F1} mm}"
                                                           Foreground="#FF1B98E0" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#FFAAB4C0" FontSize="11"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════ RIGHT VIEWPORT ═══════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="#FF161B22"
                    BorderBrush="#FF2D3340" BorderThickness="0,0,0,1" Padding="8,5">
                <DockPanel>
                    <!-- Close (right) -->
                    <Button DockPanel.Dock="Right" Content="✕  Close"
                            Command="{Binding DataContext.ClosePhotogrammetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="Transparent" BorderThickness="0" Foreground="#FF607080"
                            Padding="10,4" Cursor="Hand"/>

                    <!-- Rotate quick-action (right, before close) -->
                    <Button DockPanel.Dock="Right" Content="↻"
                            Command="{Binding ActivePhoto.Rotate90Command}"
                            ToolTip="Rotate 90° clockwise"
                            Background="Transparent" BorderThickness="0" Foreground="#FFCDD3DC"
                            Width="32" Margin="0,0,4,0" Cursor="Hand" FontSize="16"
                            Visibility="{Binding ActivePhoto, Converter={StaticResource NotNullToVis}}"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="🖐  Pan" Style="{StaticResource ToolBtn}" GroupName="Tools"
                                     IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Pan}"
                                     Command="{Binding SelectToolCommand}" CommandParameter="Pan"
                                     ToolTip="Left-drag to pan. Scroll to zoom."/>

                        <!-- Scale tool with inline CalibrationPopup -->
                        <Grid>
                            <RadioButton x:Name="BtnScale" Content="📏  Scale" Style="{StaticResource ToolBtn}" GroupName="Tools"
                                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Normalize}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="Normalize"
                                         ToolTip="Draw a line over a known reference length. A mm entry will appear inline here."/>

                            <!-- Inline calibration popup — opened from code-behind after line is drawn -->
                            <Popup x:Name="CalibrationPopup" StaysOpen="True" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=BtnScale}"
                                   Placement="Bottom" HorizontalOffset="-10" VerticalOffset="6">
                                <Border Background="#FF141920" BorderBrush="#FF1B98E0"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="14,12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Width="240">
                                        <TextBlock Text="📏 Calibrate Scale" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBlock Text="Length of the drawn line:" Foreground="#FFAAB4C0"
                                                   FontSize="11" Margin="0,0,0,8"/>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock DockPanel.Dock="Right" Text=" mm"
                                                       Foreground="#FF607080" FontSize="12"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBox x:Name="CalibrationInput"
                                                     FontSize="13" Padding="8,5"
                                                     Background="#FF0E1520"
                                                     Foreground="White"
                                                     CaretBrush="White"
                                                     BorderBrush="#FF2D4060" BorderThickness="1"
                                                     KeyDown="CalibrationInput_KeyDown"
                                                     VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CalibrationApply" Content="Apply"
                                                    Width="72" Padding="0,6"
                                                    Background="#FF1B98E0" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"
                                                    Click="CalibrationApply_Click"/>
                                            <Button x:Name="CalibrationCancel" Content="Cancel"
                                                    Width="64" Padding="0,6" Margin="8,0,0,0"
                                                    Background="#FF1E2530" Foreground="#FF8A9BB0"
                                                    BorderThickness="1" BorderBrush="#FF2D3340"
                                                    Cursor="Hand"
                                                    Click="CalibrationCancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <RadioButton Content="📐  Horizon" Style="{StaticResource ToolBtn}" GroupName="Tools"
                                     IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Horizon}"
                                     Command="{Binding SelectToolCommand}" CommandParameter="Horizon"
                                     ToolTip="Draw a line between two symmetrical reference points to level the image."/>

                        <RadioButton Content="✏️  Measure" Style="{StaticResource ToolBtn}" GroupName="Tools"
                                     IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Measure}"
                                     Command="{Binding SelectToolCommand}" CommandParameter="Measure"
                                     ToolTip="Draw a line to read distance in mm (requires Scale calibration)."/>

                        <RadioButton Content="∠  Angle" Style="{StaticResource ToolBtn}" GroupName="Tools"
                                     IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Angle}"
                                     Command="{Binding SelectToolCommand}" CommandParameter="Angle"
                                     ToolTip="Draw two lines sequentially — shows angle between them. (1st drag → 2nd drag)"/>

                        <RadioButton Content="✒  Line" Style="{StaticResource ToolBtn}" GroupName="Tools"
                                     IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=DrawLine}"
                                     Command="{Binding SelectToolCommand}" CommandParameter="DrawLine"
                                     ToolTip="Draw a persistent annotation line."/>

                        <Separator Width="1" Background="#FF2D3340" Margin="8,4"/>

                        <CheckBox Content="Grid"
                                  IsChecked="{Binding ShowGridOverlay}"
                                  Foreground="#FFCDD3DC" VerticalAlignment="Center" Margin="4,0"
                                  ToolTip="Show calibration grid overlay (requires Scale)."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Viewport canvas -->
            <Grid Grid.Row="1" x:Name="ViewportHost" Background="#FF080B10"
                  ClipToBounds="True"
                  MouseWheel="Viewport_MouseWheel"
                  MouseLeftButtonDown="Viewport_MouseDown"
                  MouseLeftButtonUp="Viewport_MouseUp"
                  MouseMove="Viewport_MouseMove"
                  SizeChanged="Viewport_SizeChanged">

                <Canvas x:Name="MasterCanvas" IsHitTestVisible="False"/>

                <TextBlock Text="No photo loaded — click ＋ Load Photos…"
                           Foreground="#FF303845" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ActivePhoto, Converter={StaticResource NullToVis}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
