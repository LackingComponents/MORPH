<Window x:Class="OrthoPlanner.App.DentalCastEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Dental Cast Editor" Width="1300" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E1420" Foreground="White" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Reusable panel header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF6E7A8A"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF1C2030"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2E3A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF283040"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A90D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#FF1B5EA0"/>
            <Setter Property="BorderBrush" Value="#FF2E80D0"/>
        </Style>
        <Style x:Key="DestructiveBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#FF5A1A1A"/>
            <Setter Property="BorderBrush" Value="#FF902020"/>
        </Style>
        <Style x:Key="ShellItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E3A5A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1A2840"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="*"/>      <!-- Main content -->
            <RowDefinition Height="Auto"/>   <!-- Status + footer -->
        </Grid.RowDefinitions>

        <!-- ── Title ───────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Dental Cast Editor" FontSize="16" FontWeight="SemiBold" Foreground="#EAECF0"/>
            <TextBlock x:Name="InstructionText"
                       Text="Select a model from the Shells panel. Use the Clip Plane to remove gingiva. Split shells, close surfaces, then Apply."
                       FontSize="11" Foreground="#88AABB" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ── Main 3-column content ────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>   <!-- Left tools -->
                <ColumnDefinition Width="*"/>     <!-- 3D Viewport -->
                <ColumnDefinition Width="200"/>   <!-- Right shells panel -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Tool Panel ───────────────────────────────────── -->
            <Border Grid.Column="0" Background="#FF141922" BorderBrush="#FF2A3245"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Clip Plane section -->
                        <TextBlock Text="CLIP PLANE" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="ShowClipPlaneCheck" Content="Show clip plane"
                                  IsChecked="True" Foreground="#AABBCC" FontSize="11"
                                  Checked="ShowClipPlane_Changed" Unchecked="ShowClipPlane_Changed"
                                  Margin="0,0,0,6"/>

                        <!-- Axis selector -->
                        <TextBlock Text="Axis" Foreground="#6E7A8A" FontSize="10" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="AxisX" Content="X" GroupName="ClipAxis"
                                         Foreground="White" FontSize="11" Margin="0,0,8,0"
                                         Checked="ClipAxis_Changed"/>
                            <RadioButton x:Name="AxisY" Content="Y" GroupName="ClipAxis"
                                         Foreground="White" FontSize="11" Margin="0,0,8,0"
                                         Checked="ClipAxis_Changed"/>
                            <RadioButton x:Name="AxisZ" Content="Z" GroupName="ClipAxis"
                                         IsChecked="True" Foreground="White" FontSize="11"
                                         Checked="ClipAxis_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Position" Foreground="#6E7A8A" FontSize="10" Margin="0,0,0,2"/>
                        <Slider x:Name="ClipPosSlider" Minimum="0" Maximum="1" Value="0.5"
                                ValueChanged="ClipPos_Changed" Margin="0,0,0,2"/>
                        <TextBlock x:Name="ClipPosLabel" Text="0.00 mm"
                                   Foreground="#AAB" FontSize="10" Margin="0,0,0,6"/>

                        <TextBlock Text="Keep side" Foreground="#6E7A8A" FontSize="10" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="KeepAbove" Content="Above +" GroupName="KeepSide"
                                         IsChecked="True" Foreground="White" FontSize="11" Margin="0,0,8,0"/>
                            <RadioButton x:Name="KeepBelow" Content="Below −" GroupName="KeepSide"
                                         Foreground="White" FontSize="11"/>
                        </StackPanel>

                        <Button x:Name="ApplyClipBtn" Content="Apply Clip" Style="{StaticResource AccentBtn}"
                                Click="ApplyClip_Click"/>
                        <Button x:Name="UndoClipBtn" Content="Undo Last Clip" Style="{StaticResource ToolBtn}"
                                Click="UndoClip_Click" IsEnabled="False" Margin="0,2,0,8"/>

                        <!-- Close Surfaces -->
                        <TextBlock Text="SURFACES" Style="{StaticResource SectionHeader}"/>
                        <Button Content="Close Open Surfaces" Style="{StaticResource ToolBtn}"
                                Click="CloseSurfaces_Click"/>

                        <!-- Shell management -->
                        <TextBlock Text="SHELLS" Style="{StaticResource SectionHeader}"/>
                        <Button Content="Split into Shells" Style="{StaticResource ToolBtn}"
                                Click="SplitShells_Click"/>
                        <Button Content="Keep Selected Shell" Style="{StaticResource AccentBtn}"
                                Click="KeepSelectedShell_Click" Margin="0,2"/>
                        <Button Content="Remove Selected Shell" Style="{StaticResource DestructiveBtn}"
                                Click="RemoveSelectedShell_Click" Margin="0,2"/>
                        <Button Content="Merge All Shells" Style="{StaticResource ToolBtn}"
                                Click="MergeShells_Click" Margin="0,2,0,8"/>

                        <!-- View -->
                        <TextBlock Text="VIEW" Style="{StaticResource SectionHeader}"/>
                        <Button Content="Fit to View" Style="{StaticResource ToolBtn}"
                                Click="FitView_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── CENTRE: 3D Viewport ───────────────────────────────── -->
            <Border Grid.Column="1" BorderBrush="#30FFFFFF" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True">
                <hx:Viewport3DX ShowCameraTarget="False" x:Name="MainViewport" BackgroundColor="#FF080C14"
                                ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                ZoomExtentsWhenLoaded="False"
                                IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                RotateAroundMouseDownPoint="False"
                                CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                ShowViewCube="False" IsInertiaEnabled="False">
                    <hx:Viewport3DX.Camera>
                        <hx:PerspectiveCamera x:Name="SubCamera" Position="0,-150,80"
                                              LookDirection="0,1,-0.4" UpDirection="0,0,1"
                                              FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                    </hx:Viewport3DX.Camera>
                    <hx:AmbientLight3D Color="#606060"/>
                    <hx:DirectionalLight3D x:Name="Headlamp" Direction="0,-1,0" Color="#E0E0E0"/>
                    <hx:DirectionalLight3D x:Name="Backlamp" Direction="0,1,0" Color="#C0C0C0"/>
                    <hx:GroupModel3D x:Name="MainGroup"/>
                </hx:Viewport3DX>
            </Border>

            <!-- ── RIGHT: Shells / Models panel ─────────────────────── -->
            <Border Grid.Column="2" Background="#FF141922" BorderBrush="#FF2A3245"
                    BorderThickness="1" CornerRadius="4" Margin="6,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MODELS / SHELLS" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,6"/>

                    <!-- Model selector (if multiple scans loaded) -->
                    <ComboBox x:Name="ModelSelector" Grid.Row="1"
                              Background="#FF1C2030" Foreground="White"
                              BorderBrush="#FF2E3A50" Margin="0,0,0,8" FontSize="11"
                              SelectionChanged="ModelSelector_SelectionChanged"/>

                    <!-- Shell list -->
                    <ListBox x:Name="ShellList" Grid.Row="2"
                             Background="#FF0E1420" BorderThickness="0"
                             SelectionChanged="ShellList_SelectionChanged"
                             ItemContainerStyle="{StaticResource ShellItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="{Binding TriangleCountText}" FontSize="9" Foreground="#6E7A8A"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsVisible}"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="ShellVisibility_Changed"
                                              Unchecked="ShellVisibility_Changed"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Shell stats -->
                    <TextBlock x:Name="ShellStatsText" Grid.Row="3"
                               Text="" FontSize="9" Foreground="#6E7A8A"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Status + Footer ──────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" Width="80" Height="28"
                    Background="#20FFFFFF" Foreground="White" BorderBrush="#40FFFFFF"
                    Cursor="Hand"/>

            <TextBlock Grid.Column="1" x:Name="StatusText"
                       Text="Ready" FontSize="10" Foreground="#AAB"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RevertBtn" Content="Revert to Original" Click="Revert_Click"
                        Width="130" Height="28" Cursor="Hand" Margin="0,0,8,0"
                        Background="#30403030" Foreground="White" BorderBrush="#50705050"/>
                <Button x:Name="ApplyBtn" Content="Apply to Viewport" Click="Apply_Click"
                        Width="130" Height="28" Cursor="Hand"
                        Background="#30408040" Foreground="White" BorderBrush="#507090"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
