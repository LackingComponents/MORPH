<UserControl x:Class="OrthoPlanner.App.Controls.ThreeDModelContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <!-- Colour swatch — right-click opens palette -->
        <Border x:Name="ColorSquare" Width="46" Height="46" Margin="2" Cursor="Hand"
                ToolTip="Right-click to pick colour"
                Background="{Binding DisplayColorBrush}"
                BorderBrush="#FF505860" BorderThickness="1" CornerRadius="2"
                MouseRightButtonUp="ColorSquare_MouseRightButtonUp">
            <Border.ContextMenu>
                <ContextMenu x:Name="ColorPaletteMenu"
                             Background="#FF1E222A" BorderBrush="#FF30343D" BorderThickness="1"
                             StaysOpen="False">
                    <ContextMenu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8"/>
                        </ItemsPanelTemplate>
                    </ContextMenu.ItemsPanel>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- Transparency — diagonal slider -->
        <Border Width="46" Height="46" Margin="2"
                Background="#FF282C34" BorderBrush="#FF505860" BorderThickness="1" CornerRadius="2">
            <Grid ClipToBounds="True">
                <Slider x:Name="OpacitySlider"
                        Minimum="0" Maximum="100"
                        Value="{Binding OpacityPercent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Width="62" Height="22"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="OpacitySlider_PreviewMouseLeftButtonDown">
                    <Slider.RenderTransform>
                        <RotateTransform Angle="-45"/>
                    </Slider.RenderTransform>
                </Slider>
                <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:F0}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold" Foreground="White"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Export -->
        <Button x:Name="ExpButton" Width="46" Height="46" Margin="2" Padding="0" Cursor="Hand"
                Background="#FF1B98E0" Foreground="White"
                FontSize="11" FontWeight="Bold" Content="exp"
                ToolTip="Save as STL or OBJ"
                Click="ExpButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#FF505860" BorderThickness="1" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF2196F3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
