<UserControl x:Class="OrthoPlanner.App.Controls.ThreeDModelContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Classic transparency checkerboard -->
        <DrawingBrush x:Key="TransparencyCheckerboard" TileMode="Tile"
                      Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF2A2E36">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF3A4048">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4"/>
                                <RectangleGeometry Rect="4,4,4,4"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Full-area vertical drag — no visible track or thumb -->
        <Style x:Key="InvisibleVerticalOpacitySlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent"
                                                        Width="{TemplateBinding Width}"
                                                        Height="10"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- Colour swatch — click opens square palette -->
        <Grid Width="46" Height="46" Margin="2">
            <Border x:Name="ColorSquare" Cursor="Hand"
                    ToolTip="Click to pick colour"
                    Background="{Binding DisplayColorBrush}"
                    BorderBrush="#FF505860" BorderThickness="1" CornerRadius="2"
                    MouseLeftButtonUp="ColorSquare_MouseLeftButtonUp"/>
            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorSquare}"
                   Placement="Right" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="4">
                <Border Width="130" Height="130" Background="#FF1E222A"
                        BorderBrush="#FF30343D" BorderThickness="1" CornerRadius="3" Padding="4">
                    <UniformGrid x:Name="ColorGrid" Columns="5" Rows="6"/>
                </Border>
            </Popup>
        </Grid>

        <!-- Transparency — drag vertically anywhere on the square -->
        <Border Width="46" Height="46" Margin="2"
                BorderBrush="#FF505860" BorderThickness="1" CornerRadius="2" ClipToBounds="True"
                ToolTip="Drag up/down to change transparency">
            <Grid>
                <Border Background="{StaticResource TransparencyCheckerboard}" IsHitTestVisible="False"/>
                <Border Background="{Binding DisplayColorBrush}" Opacity="{Binding Opacity}" IsHitTestVisible="False"/>
                <Border Background="#18000000" IsHitTestVisible="False"/>

                <!-- Layered-circles opacity glyph -->
                <Viewbox Width="22" Height="22" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="0,-8,0,10" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="3" Canvas.Top="11" Width="18" Height="9"
                                 Stroke="#E8FFFFFF" StrokeThickness="1.2" Fill="#30FFFFFF"/>
                        <Ellipse Canvas.Left="5" Canvas.Top="7" Width="18" Height="9"
                                 Stroke="#F0FFFFFF" StrokeThickness="1.2" Fill="#55FFFFFF"/>
                        <Ellipse Canvas.Left="7" Canvas.Top="3" Width="18" Height="9"
                                 Stroke="#FFFFFF" StrokeThickness="1.2" Fill="#80FFFFFF"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:F0}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,2,0,0" FontSize="10" Foreground="#E0FFFFFF"
                           IsHitTestVisible="False"/>

                <Slider x:Name="OpacitySlider"
                        Minimum="0" Maximum="100"
                        Value="{Binding OpacityPercent, Mode=TwoWay}"
                        Style="{StaticResource InvisibleVerticalOpacitySlider}"
                        PreviewMouseLeftButtonDown="OpacitySlider_PreviewMouseLeftButtonDown"/>
            </Grid>
        </Border>

        <!-- Export -->
        <Button x:Name="ExpButton" Width="46" Height="46" Margin="2" Padding="0" Cursor="Hand"
                Background="#FF1B98E0" Foreground="White"
                FontFamily="Segoe UI" FontSize="11" FontWeight="Normal" Content="EXP"
                ToolTip="Save as STL or OBJ"
                Click="ExpButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#FF505860" BorderThickness="1" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF2196F3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
