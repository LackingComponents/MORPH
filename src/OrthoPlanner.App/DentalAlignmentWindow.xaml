<Window x:Class="OrthoPlanner.App.DentalAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Dental Scan Alignment Wizard" Width="1200" Height="750"
        WindowStartupLocation="CenterOwner" Background="#FF0C1018" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / instructions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StepTitle" Text="Step 1: Pick Matching Landmarks" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="StepInstructions" FontSize="11" Foreground="#AAB" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Left-click on the surface to place landmarks (numbered in order). Right-click near an existing landmark to delete it. Place the same points on both sides in the same order."/>
        </StackPanel>

        <!-- 3D Viewers -->
        <Grid Grid.Row="1" Margin="0,12,0,0" x:Name="ViewersContainer">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CT dental model -->
            <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <hx:Viewport3DX x:Name="CtViewport" BackgroundColor="#FF0E1420"
                                               ShowCoordinateSystem="True" CoordinateSystemLabelForeground="White"
                                               ZoomExtentsWhenLoaded="False"
                                               IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                               RotateAroundMouseDownPoint="False"
                                               CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                               ShowViewCube="False"
                                               IsInertiaEnabled="False"
                                               PreviewMouseLeftButtonDown="CtViewport_PreviewMouseLeftButtonDown"
                                               PreviewMouseRightButtonDown="CtViewport_PreviewMouseRightButtonDown">
                            <hx:Viewport3DX.Camera>
                                <hx:PerspectiveCamera x:Name="CtCamera" Position="0,-300,100" LookDirection="0,1,-0.3"
                                                   UpDirection="0,0,1" FieldOfView="45"
                                                   NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                            </hx:Viewport3DX.Camera>
                            <hx:AmbientLight3D Color="#505050"/>
                            <hx:DirectionalLight3D x:Name="CtHeadlamp" Direction="0,-1,0" Color="#D0D0D0" />
                            <hx:DirectionalLight3D x:Name="CtBacklamp" Direction="0,1,0" Color="#A0A0A0" />
                            <hx:GroupModel3D x:Name="CtGroup" />
                        </hx:Viewport3DX>
                        <TextBlock Text="🦴 CT Dental Surface" FontSize="11" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                        <TextBlock Text="Left-click = add | Right-click near marker = remove" FontSize="9" Foreground="#44FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </Grid>
            </Border>

            <!-- Separator -->
            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- STL scan -->
            <Border Grid.Column="2" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <hx:Viewport3DX x:Name="StlViewport" BackgroundColor="#FF0E1420"
                                               ShowCoordinateSystem="True" CoordinateSystemLabelForeground="White"
                                               ZoomExtentsWhenLoaded="False"
                                               IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                               RotateAroundMouseDownPoint="False"
                                               CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                               ShowViewCube="False"
                                               IsInertiaEnabled="False"
                                               PreviewMouseLeftButtonDown="StlViewport_PreviewMouseLeftButtonDown"
                                               PreviewMouseRightButtonDown="StlViewport_PreviewMouseRightButtonDown">
                            <hx:Viewport3DX.Camera>
                                <hx:PerspectiveCamera x:Name="StlCamera" Position="0,-300,0" LookDirection="0,1,0"
                                                   UpDirection="0,0,1" FieldOfView="45"
                                                   NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                            </hx:Viewport3DX.Camera>
                            <hx:AmbientLight3D Color="#505050"/>
                            <hx:DirectionalLight3D x:Name="StlHeadlamp" Direction="0,-1,0" Color="#D0D0D0" />
                            <hx:DirectionalLight3D x:Name="StlBacklamp" Direction="0,1,0" Color="#A0A0A0" />
                            <hx:GroupModel3D x:Name="StlGroup" />
                        </hx:Viewport3DX>
                        <TextBlock Text="🦷 Dental STL Scan" FontSize="11" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                        <TextBlock Text="Left-click = add | Right-click near marker = remove" FontSize="9" Foreground="#44FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </Grid>
            </Border>
        </Grid>

        <!-- Landmark pairs list -->
        <Border Grid.Row="2" Margin="0,6,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="6"
                Height="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PairsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,2" Margin="0,1" CornerRadius="3" Background="#08FFFFFF">
                                <TextBlock VerticalAlignment="Center" FontSize="10">
                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="#CCC"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding CtText, Mode=OneWay}" Foreground="#6F8"/>
                                    <Run Text=" ↔ " Foreground="#888"/>
                                    <Run Text="{Binding StlText, Mode=OneWay}" Foreground="#F86"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer controls -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="LandmarkCountText" Text="Landmarks: 0 pairs" FontSize="11" Foreground="#AAB" VerticalAlignment="Center"/>
                <Button x:Name="ClearLandmarksBtn" Content="Clear All" Margin="12,0,0,0" Padding="8,4"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0" Click="ClearLandmarks_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <CheckBox x:Name="SkipIcpCheckBox" Content="Skip ICP Override" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#AAB" FontSize="11" />
                <TextBlock x:Name="RmsText" Text="" FontSize="11" Foreground="#8CF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="ComputeBtn" Content="⚡ Compute Alignment" Padding="10,6"
                        Background="#FF1B98E0" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        IsEnabled="False" Click="ComputeAlignment_Click"/>
                <Button x:Name="AcceptBtn" Content="✔ Accept" Padding="10,6" Margin="8,0,0,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Visibility="Collapsed" Click="Accept_Click"/>
                <Button x:Name="CleanMergeBtn" Content="🧹 Clean &amp; Merge Cast" Padding="10,6" Margin="8,0,0,0"
                        Background="#FFA020F0" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Visibility="Collapsed" Click="CleanMerge_Click"/>
                <CheckBox x:Name="CloseHolesCheckBox" Content="Make Watertight" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#AAB" FontSize="11" Visibility="Collapsed" />
                <Button Content="Cancel" Padding="10,6" Margin="8,0,0,0"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
