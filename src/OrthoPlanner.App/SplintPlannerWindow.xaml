<Window x:Class="OrthoPlanner.App.SplintPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Splint Planner — Final Occlusion" Width="1280" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C1018" Foreground="White"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock x:Name="StepTitle" Text="Step 1: Place ≥ 3 points on each arch"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="StepInstructions" FontSize="11" Foreground="#AABBCC" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Left-click on the UPPER arch (left viewport) to define the maxillary arch curve. Then do the same on the LOWER arch (right viewport). Right-click near a point to remove it."/>
        </StackPanel>

        <!-- 3D Viewports — side by side -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- UPPER ARCH (maxilla) — left viewport, camera from below -->
            <Border x:Name="UpperViewportBorder" Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="UpperViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="UpperViewport_MouseLeft"
                                    PreviewMouseRightButtonDown="UpperViewport_MouseRight"
                                    PreviewMouseMove="UpperViewport_MouseMove"
                                    PreviewMouseLeftButtonUp="UpperViewport_MouseLeftUp">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="UpperCamera"
                                                  Position="0,0,-400" LookDirection="0,0,1"
                                                  UpDirection="0,-1,0" FieldOfView="40"
                                                  NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="UpperHeadlamp" Direction="0,0,1"  Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="UpperBacklamp"  Direction="0,0,-1" Color="#808080"/>
                        <hx:GroupModel3D x:Name="UpperGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock x:Name="UpperViewportTitle" Text="🦷 Upper Arch (Maxilla) — Occlusal from below"
                               FontSize="11" Foreground="#88FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="UpperViewportHint" Text="Left-click = add point  |  Right-click = remove last"
                               FontSize="9" Foreground="#44FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               IsHitTestVisible="False"/>
                    <StackPanel x:Name="ReviewVisibilityPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,8"
                                Visibility="Collapsed">
                        <CheckBox x:Name="ShowUpperCastToggle"
                                  Content="Upper"
                                  IsChecked="True"
                                  Margin="0,0,10,0"
                                  ToolTip="Show/hide the superior dental cast"/>
                        <CheckBox x:Name="ShowLowerCastToggle"
                                  Content="Lower"
                                  IsChecked="True"
                                  ToolTip="Show/hide the inferior dental cast"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="ViewportSplitter" Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- LOWER ARCH (mandible) — right viewport, camera from above -->
            <Border x:Name="LowerViewportBorder" Grid.Column="2" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="LowerViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="LowerViewport_MouseLeft"
                                    PreviewMouseRightButtonDown="LowerViewport_MouseRight"
                                    PreviewMouseMove="LowerViewport_MouseMove"
                                    PreviewMouseLeftButtonUp="LowerViewport_MouseLeftUp">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="LowerCamera"
                                                  Position="0,0,400" LookDirection="0,0,-1"
                                                  UpDirection="0,-1,0" FieldOfView="40"
                                                  NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="LowerHeadlamp" Direction="0,0,-1" Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="LowerBacklamp"  Direction="0,0,1"  Color="#808080"/>
                        <hx:GroupModel3D x:Name="LowerGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock Text="🦷 Lower Arch (Mandible) — Occlusal from above"
                               FontSize="11" Foreground="#88FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="Left-click = add point  |  Right-click = remove last"
                               FontSize="9" Foreground="#44FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings Panel (Right Column) -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Margin="10,4,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Parameters" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>


                <!-- Upper controls -->

                <TextBlock Text="UPPER ARCH" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,6"/>
                <TextBlock Text="Upper crown envelope:" FontSize="11" Foreground="#AABBCC" ToolTip="Vertical extent of the wafer above the upper arch curve.&#x0a;+2 mm (default): the splint wraps 2 mm up around the maxillary crowns, creating a deep tooth pocket.&#x0a;0 mm: the top surface is flush with the arch curve at the cusp tips.&#x0a;−2 mm: the top is trimmed 2 mm inside the cusp line — use only for a thin bite- registration rim.&#x0a;In the SDF pipeline this sets the upper Z-clip plane. The tooth pocket is always carved by the actual tooth SDF regardless of this value."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Slider x:Name="UpperPenetrationSlider" Minimum="-5" Maximum="10" Value="1" Width="170" SmallChange="0.5" ValueChanged="UpperPenetrationSlider_ValueChanged"/>
                    <TextBlock x:Name="UpperPenetrationLabel" Text="1.0 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Lower controls -->
                <TextBlock Text="LOWER ARCH" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,6"/>
                <TextBlock Text="Lower crown envelope:" FontSize="11" Foreground="#AABBCC" ToolTip="Vertical extent of the wafer below the lower arch curve.&#x0a;+2 mm (default): the splint wraps 2 mm down around the mandibular crowns.&#x0a;0 mm: the bottom surface is flush with the arch curve at the cusp tips.&#x0a;−2 mm: the bottom is trimmed 2 mm inside the cusp line.&#x0a;Same as the upper envelope, but for the lower arch. Sets the lower Z-clip plane."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Slider x:Name="LowerPenetrationSlider" Minimum="-5" Maximum="10" Value="1" Width="170" SmallChange="0.5" ValueChanged="LowerPenetrationSlider_ValueChanged"/>
                    <TextBlock x:Name="LowerPenetrationLabel" Text="1.0 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- General controls -->
                <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,6"/>

                <TextBlock Text="Labio-lingual width:" FontSize="11" Foreground="#AABBCC" ToolTip="Total thickness of the splint wall from the lingual (tongue-side) to the buccal (cheek-side) surface.&#x0a;8 mm (default): standard surgical wafer width that fully covers the occlusal table.&#x0a;Smaller values produce a narrower, lighter wafer but may not engage all cusps.&#x0a;This sets the XY clip-pad radius around the arch curve, so the SDF blank only extends this far from the arch center."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Slider x:Name="ThicknessSlider" Minimum="2" Maximum="20" Value="8" Width="170" SmallChange="0.5" ValueChanged="ThicknessSlider_ValueChanged"/>
                    <TextBlock x:Name="ThicknessLabel" Text="8.0 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Lingual-Buccal bias:" FontSize="11" Foreground="#AABBCC" ToolTip="Shifts the splint center outward (buccally, +) or inward (lingually, −) while keeping the total labio-lingual width constant.&#x0a;0 mm (default): the splint is centered on the arch curve.&#x0a;+2 mm: the splint wall is 2 mm thicker on the buccal side and 2 mm thinner on the lingual side — useful when the buccal flange needs more material for screw fixation.&#x0a;Negative values shift toward the tongue."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Slider x:Name="LingualBuccalBiasSlider" Minimum="-5" Maximum="5" Value="0" Width="170" SmallChange="0.25" ValueChanged="LingualBuccalBiasSlider_ValueChanged"/>
                    <TextBlock x:Name="LingualBuccalBiasLabel" Text="0.0 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Vestibular trim:" FontSize="11" Foreground="#AABBCC" ToolTip="Controls how far the vestibular (buccal) wall extends beyond the arch outline.&#x0a;0 (default): the wall preserves the full natural tooth anatomy including molar walls.&#x0a;−3: trim 3 mm — actively clips bracket wrapping that protrudes beyond the tooth outline.&#x0a;+2: allow 2 mm wider vestibular walls — use for wider buccal flanges or screw fixation."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Slider x:Name="VestibularTrimSlider" Minimum="-5" Maximum="10" Value="-3.2" Width="170" SmallChange="0.25" ValueChanged="VestibularTrimSlider_ValueChanged"/>
                    <TextBlock x:Name="VestibularTrimLabel" Text="-3.2 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="VestibularOneSidedCheck" Content="One-sided (buccal only)" IsChecked="False"
                          Foreground="#AABBCC" Margin="0,0,0,12"
                          ToolTip="When ON, after the bridge is closed, remove material that extends beyond the most-anterior arch on the buccal side only (using the same vestibular trim margin). This cuts unwanted splint wall that protrudes past the dental arch vestibularly."/>

                <TextBlock Text="Thickness:" FontSize="11" Foreground="#AABBCC" ToolTip="Extra material in the bridge region between upper and lower arch halves.&#x0a;0 mm (default): only the standard 1 mm wall-thickness dilation and morphological closing — the bridge is as thin as the closing radius allows.&#x0a;+2 mm: the bridge region gets an extra 2 mm of material — use when a thin bridge would be too fragile for handling or screw retention.&#x0a;Applied as a continuous SDF bias (any value works, not rounded to grid steps). Also counteracts erosion that thins the bridge during morphological closing."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Slider x:Name="BridgeThicknessSlider" Minimum="0" Maximum="10" Value="0" Width="170" SmallChange="0.5" ValueChanged="BridgeThicknessSlider_ValueChanged"/>
                    <TextBlock x:Name="BridgeThicknessLabel" Text="0.0 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Closing erosion:" FontSize="11" Foreground="#AABBCC" ToolTip="How aggressively the morphological closing step erodes after dilation.&#x0a;100% (symmetric): clean outer walls but thin bridge.&#x0a;45% (default, asymmetric): thicker bridge, slightly rounder outer walls.&#x0a;Lower = more material preserved everywhere, especially the bridge."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Slider x:Name="CloseErodeSlider" Minimum="10" Maximum="100" Value="65" Width="170" SmallChange="5" ValueChanged="CloseErodeSlider_ValueChanged"/>
                    <TextBlock x:Name="CloseErodeLabel" Text="65%" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Bridge SDF depth:" FontSize="11" Foreground="#AABBCC" ToolTip="Base SDF depth for bridge voxels (mm).&#x0a;0.5 (default): minimal interior margin — bridge is thin but may get holes from blur.&#x0a;1.0–2.0: deeper bridge that survives aggressive blur, but the splint thickens slightly in the bridge region."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Slider x:Name="BridgeSdfBaseSlider" Minimum="0" Maximum="5" Value="0.6" Width="170" SmallChange="0.1" ValueChanged="BridgeSdfBaseSlider_ValueChanged"/>
                    <TextBlock x:Name="BridgeSdfBaseLabel" Text="0.6 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Clinical fit & printability -->
                <TextBlock Text="CLINICAL FIT" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,8,0,6"/>

                <CheckBox x:Name="BlockoutCheck" Content="Block out undercuts (seatability)" IsChecked="False"
                          Foreground="#AABBCC" Margin="0,0,0,8"
                          ToolTip="When ON, forces every tooth pocket to go vertical past the engagement depth — eliminating undercuts that would prevent the splint from seating or being removed.&#x0a;OFF by default: pockets follow natural tooth anatomy (including undercuts), giving maximum retention but making insertion/removal harder.&#x0a;Turn ON for a splint that must seat and release easily (e.g. intraoperative wafer).&#x0a;In the pipeline this clamps SDF voxels below the arch-Z engagement plane to splint material before pocket subtraction."/>

                <TextBlock Text="Engagement depth:" FontSize="11" Foreground="#AABBCC" ToolTip="Only used when 'Block out undercuts' is ON.&#x0a;How far below the arch-curve Z-plane the pocket is allowed to engage the tooth before being blocked out.&#x0a;1.5 mm (default): pockets engage 1.5 mm past the height of contour, then go vertical.&#x0a;0 mm: no engagement at all — pockets are vertical from the arch plane down.&#x0a;3 mm: deep undercut engagement for maximum retention (harder to insert)."/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Slider x:Name="EngagementDepthSlider" Minimum="0" Maximum="5" Value="1.5" Width="170" SmallChange="0.25" ValueChanged="EngagementDepthSlider_ValueChanged"/>
                    <TextBlock x:Name="EngagementDepthLabel" Text="1.5 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Buccal flange depth:" FontSize="11" Foreground="#AABBCC" ToolTip="Apical extension of the splint skirt down (or up) the buccal wall of the jaw.&#x0a;0 mm (default): no flange — the splint covers only the occlusal table.&#x0a;5 mm: a 5 mm tall buccal skirt for rigid fixation with screws through the flange.&#x0a;Combine with the 'on upper' / 'on lower' radio buttons to choose which arch gets the flange.&#x0a;(Currently a placeholder — flange geometry is not yet implemented in the SDF pipeline.)"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Slider x:Name="FlangeDepthSlider" Minimum="0" Maximum="15" Value="0" Width="170" SmallChange="0.5" ValueChanged="FlangeDepthSlider_ValueChanged"/>
                    <TextBlock x:Name="FlangeDepthLabel" Text="0.0 mm" FontSize="11" Foreground="#8CF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton x:Name="FlangeUpperRadio" Content="on upper" IsChecked="True" GroupName="FlangeArch"
                             Foreground="#AABBCC" FontSize="10" Margin="0,0,0,2"/>
                <RadioButton x:Name="FlangeLowerRadio" Content="on lower" GroupName="FlangeArch"
                             Foreground="#AABBCC" FontSize="10" Margin="0,0,0,4"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Point count status bar -->
        <Border Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="6" Height="36">
            <Grid>
                <TextBlock x:Name="PointCountText" Text="Upper: 0 pts  |  Lower: 0 pts" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="QualityText" Text="" FontSize="11" Foreground="#F80" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Footer buttons -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Clear Upper" Padding="8,4" Margin="0,0,6,0"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="ClearUpper_Click"/>
                <Button Content="Clear Lower" Padding="8,4"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="ClearLower_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="GenerateBtn" Content="⚙ Generate Splint" Padding="10,6" Margin="0,0,8,0"
                        Background="#FF1B98E0" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        IsEnabled="False" Click="GenerateBtn_Click"/>
                <Button x:Name="AcceptBtn" Content="✔ Accept" Padding="10,6" Margin="0,0,8,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Visibility="Collapsed" Click="AcceptBtn_Click"/>
                <Button Content="Cancel" Padding="10,6"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
