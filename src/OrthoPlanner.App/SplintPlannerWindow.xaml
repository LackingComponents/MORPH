<Window x:Class="OrthoPlanner.App.SplintPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Splint Planner — Final Occlusion" Width="1280" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C1018" Foreground="White"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StepTitle" Text="Step 1: Place ≥ 3 points on each arch"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="StepInstructions" FontSize="11" Foreground="#AABBCC" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Left-click on the UPPER arch (left viewport) to define the maxillary arch curve. Then do the same on the LOWER arch (right viewport). Right-click near a point to remove it."/>
        </StackPanel>

        <!-- 3D Viewports — side by side -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- UPPER ARCH (maxilla) — left viewport, camera from below -->
            <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="UpperViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="UpperViewport_MouseLeft"
                                    PreviewMouseRightButtonDown="UpperViewport_MouseRight"
                                    PreviewMouseMove="UpperViewport_MouseMove"
                                    PreviewMouseLeftButtonUp="UpperViewport_MouseLeftUp">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="UpperCamera"
                                                  Position="0,0,-250" LookDirection="0,0,1"
                                                  UpDirection="0,-1,0" FieldOfView="40"
                                                  NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="UpperHeadlamp" Direction="0,0,1"  Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="UpperBacklamp"  Direction="0,0,-1" Color="#808080"/>
                        <hx:GroupModel3D x:Name="UpperGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock Text="🦷 Upper Arch (Maxilla) — Occlusal from below"
                               FontSize="11" Foreground="#88FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="Left-click = add point  |  Right-click = remove last"
                               FontSize="9" Foreground="#44FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- LOWER ARCH (mandible) — right viewport, camera from above -->
            <Border Grid.Column="2" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="LowerViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="LowerViewport_MouseLeft"
                                    PreviewMouseRightButtonDown="LowerViewport_MouseRight"
                                    PreviewMouseMove="LowerViewport_MouseMove"
                                    PreviewMouseLeftButtonUp="LowerViewport_MouseLeftUp">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="LowerCamera"
                                                  Position="0,0,250" LookDirection="0,0,-1"
                                                  UpDirection="0,-1,0" FieldOfView="40"
                                                  NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="LowerHeadlamp" Direction="0,0,-1" Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="LowerBacklamp"  Direction="0,0,1"  Color="#808080"/>
                        <hx:GroupModel3D x:Name="LowerGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock Text="🦷 Lower Arch (Mandible) — Occlusal from above"
                               FontSize="11" Foreground="#88FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="Left-click = add point  |  Right-click = remove last"
                               FontSize="9" Foreground="#44FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Point count status bar -->
        <Border Grid.Row="2" Margin="0,6,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="6" Height="36">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PointCountText" Text="Upper: 0 pts  |  Lower: 0 pts"
                           FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>

                <TextBlock Text="   Labio-lingual width:" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                <Slider x:Name="ThicknessSlider" Minimum="2" Maximum="20" Value="8"
                        Width="100" Margin="6,0" VerticalAlignment="Center"
                        SmallChange="0.5" ValueChanged="ThicknessSlider_ValueChanged"/>
                <TextBlock x:Name="ThicknessLabel" Text="8.0 mm" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Width="48"/>

                <TextBlock Text="   L-B bias:" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"
                           ToolTip="Lingual-Buccal bias: shifts the splint center buccally (+) or lingually (−) while keeping total width constant"/>
                <Slider x:Name="LingualBuccalBiasSlider" Minimum="-5" Maximum="5" Value="0"
                        Width="80" Margin="6,0" VerticalAlignment="Center"
                        SmallChange="0.25" ValueChanged="LingualBuccalBiasSlider_ValueChanged"/>
                <TextBlock x:Name="LingualBuccalBiasLabel" Text="0.0 mm" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Width="48"/>

                <TextBlock Text="   Upper penetration:" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                <Slider x:Name="UpperPenetrationSlider" Minimum="-5" Maximum="10" Value="0"
                        Width="80" Margin="6,0" VerticalAlignment="Center"
                        SmallChange="0.5" ValueChanged="UpperPenetrationSlider_ValueChanged"/>
                <TextBlock x:Name="UpperPenetrationLabel" Text="0.0 mm" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Width="48"/>

                <TextBlock Text="   Lower penetration:" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                <Slider x:Name="LowerPenetrationSlider" Minimum="-5" Maximum="10" Value="0"
                        Width="80" Margin="6,0" VerticalAlignment="Center"
                        SmallChange="0.5" ValueChanged="LowerPenetrationSlider_ValueChanged"/>
                <TextBlock x:Name="LowerPenetrationLabel" Text="0.0 mm" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Width="48"/>

                <TextBlock x:Name="QualityText" Text="" FontSize="10" Foreground="#F80"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer buttons -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Clear Upper" Padding="8,4" Margin="0,0,6,0"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="ClearUpper_Click"/>
                <Button Content="Clear Lower" Padding="8,4"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="ClearLower_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="GenerateBtn" Content="⚙ Generate Splint" Padding="10,6" Margin="0,0,8,0"
                        Background="#FF1B98E0" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        IsEnabled="False" Click="GenerateBtn_Click"/>
                <Button x:Name="AcceptBtn" Content="✔ Accept" Padding="10,6" Margin="0,0,8,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Visibility="Collapsed" Click="AcceptBtn_Click"/>
                <Button Content="Cancel" Padding="10,6"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
