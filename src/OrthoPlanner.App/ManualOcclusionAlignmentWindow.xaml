<Window x:Class="OrthoPlanner.App.ManualOcclusionAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Manual Occlusion Alignment Wizard" Width="1200" Height="820"
        WindowStartupLocation="CenterOwner" Background="#FF0C1018" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StepTitle" Text="Step 1: Align Maxilla — Pick Matching Landmarks"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="StepInstructions" FontSize="11" Foreground="#AAB" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Left-click on the Maxilla bone surface to place landmarks. Left-click on the corresponding upper teeth of the Occlusion scan. Right-click near a marker to remove it. Place the same points in the same order on both sides. Min 3 spread pairs required."/>
        </StackPanel>

        <!-- 3D Viewers -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Bone Viewport -->
            <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="BoneViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="White"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="BoneViewport_MouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="BoneViewport_MouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="BoneCamera" Position="0,-300,100"
                                                  LookDirection="0,1,-0.3" UpDirection="0,0,1"
                                                  FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="BoneHeadlamp" Direction="0,-1,0" Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="BoneBacklamp" Direction="0,1,0"  Color="#A0A0A0"/>
                        <hx:GroupModel3D x:Name="BoneGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock x:Name="BoneLabel" Text="🦴 Bone Surface" FontSize="11" Foreground="#88FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                    <TextBlock Text="Left-click = add | Right-click near marker = remove" FontSize="9"
                               Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Right: Occlusion Viewport -->
            <Border Grid.Column="2" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="OccViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="White"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="OccViewport_MouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="OccViewport_MouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="OccCamera" Position="0,-300,0"
                                                  LookDirection="0,1,0" UpDirection="0,0,1"
                                                  FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="OccHeadlamp" Direction="0,-1,0" Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="OccBacklamp" Direction="0,1,0"  Color="#A0A0A0"/>
                        <hx:GroupModel3D x:Name="OccGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock x:Name="OccLabel" Text="🦷 Occlusion STL" FontSize="11" Foreground="#88FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                    <TextBlock Text="Left-click = add | Right-click near marker = remove" FontSize="9"
                               Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Landmark Pairs List -->
        <Border Grid.Row="2" Margin="0,6,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="6" Height="90">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PairsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,2" Margin="0,1" CornerRadius="3" Background="#08FFFFFF">
                                <TextBlock VerticalAlignment="Center" FontSize="10">
                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="#CCC"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding LeftText, Mode=OneWay}" Foreground="#6F8"/>
                                    <Run Text=" ↔ " Foreground="#888"/>
                                    <Run Text="{Binding RightText, Mode=OneWay}" Foreground="#F86"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="LandmarkCountText" Text="Landmarks: 0 pairs" FontSize="11"
                           Foreground="#AAB" VerticalAlignment="Center"/>
                <Button Content="Clear All" Margin="12,0,0,0" Padding="8,4"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="ClearLandmarks_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock x:Name="RmsText" Text="" FontSize="11" Foreground="#8CF"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="SkipIcpCheck" Content="Skip ICP" Foreground="#AAB" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="ComputeBtn" Content="⚡ Compute Maxilla ICP" Padding="10,6"
                        Background="#FF1B98E0" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        IsEnabled="False" Click="Compute_Click"/>
                <Button x:Name="NextStepBtn" Content="▶ Next Step: Mandible" Padding="10,6" Margin="8,0,0,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Visibility="Collapsed" Click="NextStep_Click"/>
                <Button x:Name="AcceptBtn" Content="✔ Accept &amp; Finish" Padding="10,6" Margin="8,0,0,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Visibility="Collapsed" Click="Accept_Click"/>
                <Button Content="Cancel" Padding="10,6" Margin="8,0,0,0"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
