<Window x:Class="OrthoPlanner.App.ManualOcclusionAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Manual Occlusion Alignment Wizard" Width="1200" Height="750" WindowStartupLocation="CenterOwner"
        Background="#FF0C1018" Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandPurple" Color="#FF6B44FF"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / instructions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StepTitle" Text="Step 1: Align Maxilla" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="StepInstructions" FontSize="11" Foreground="#AAB" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Left-click on the surface to place landmarks (numbered in order). Right-click near an existing landmark to delete it. Pick at least 3 points on the Maxilla and the upper teeth of the Occlusion."/>
        </StackPanel>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bone Viewport -->
            <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="BoneViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="White"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="BoneViewport_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="BoneViewport_PreviewMouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="BoneCamera" Position="0,-300,100" LookDirection="0,1,-0.3" UpDirection="0,0,1" FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="BoneHeadlamp" Direction="0,-1,0" Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="BoneBacklamp" Direction="0,1,0" Color="#A0A0A0"/>
                        <hx:GroupModel3D x:Name="BoneGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock x:Name="BoneLabel" Text="🦴 Bone Surface" FontSize="11" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                    <TextBlock Text="Left-click = add | Right-click near marker = remove" FontSize="9" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </Grid>
            </Border>

            <!-- Separator -->
            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Occlusion Viewport -->
            <Border Grid.Column="2" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <hx:Viewport3DX x:Name="OccViewport" BackgroundColor="#FF0E1420"
                                    ShowCoordinateSystem="True" CoordinateSystemLabelForeground="White"
                                    ZoomExtentsWhenLoaded="False"
                                    IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                    RotateAroundMouseDownPoint="False"
                                    CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                    ShowViewCube="False" IsInertiaEnabled="False"
                                    PreviewMouseLeftButtonDown="OccViewport_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="OccViewport_PreviewMouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="OccCamera" Position="0,-300,0" LookDirection="0,1,0" UpDirection="0,0,1" FieldOfView="45" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:AmbientLight3D Color="#505050"/>
                        <hx:DirectionalLight3D x:Name="OccHeadlamp" Direction="0,-1,0" Color="#D0D0D0"/>
                        <hx:DirectionalLight3D x:Name="OccBacklamp" Direction="0,1,0" Color="#A0A0A0"/>
                        <hx:GroupModel3D x:Name="OccGroup"/>
                    </hx:Viewport3DX>
                    <TextBlock Text="🦷 Occlusion STL" FontSize="11" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"/>
                    <TextBlock Text="Left-click = add | Right-click near marker = remove" FontSize="9" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,6,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Selected 0 pairs. Need at least 3 points." VerticalAlignment="Center" Foreground="#FFA0AABF" FontSize="12"/>
                    <TextBlock x:Name="RmsText" Text="" VerticalAlignment="Center" Foreground="#FFA0AABF" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear Markers" Click="Clear_Click" Background="#FF30343D" Foreground="White" Padding="16,8" BorderThickness="0" Margin="0,0,12,0" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="ComputeBtn" Content="Compute Maxilla ICP" IsEnabled="False" Click="Compute_Click" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
