<Window x:Class="OrthoPlanner.App.ManualOcclusionAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Manual Occlusion Alignment" Width="1200" Height="750" WindowStartupLocation="CenterOwner"
        Background="#FF0F111A">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandPurple" Color="#FF6B44FF"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#FF1E222A" BorderBrush="#FF30343D" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel>
                <TextBlock Text="Manual Occlusion Alignment" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Pick 3 matching landmarks on the Bone and the Occlusion STL. Left-click to place, Right-click to remove." FontSize="13" Foreground="#FFA0AABF" Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="Aligning:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="BoneSelector" SelectedIndex="0" Width="150" SelectionChanged="BoneSelector_SelectionChanged" Background="#FF30343D" Foreground="White" Padding="8,4">
                        <ComboBoxItem Content="Maxilla"/>
                        <ComboBoxItem Content="Mandible"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bone Viewport -->
            <Border Background="#FF161920" BorderBrush="#FF30343D" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="BoneLabel" Text="🦴 Bone Surface" FontSize="12" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8" Panel.ZIndex="1"/>
                    <hx:Viewport3DX x:Name="BoneViewport" BackgroundColor="#161920" ShowCoordinateSystem="False" ShowViewCube="False"
                                    PreviewMouseLeftButtonDown="BoneViewport_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="BoneViewport_PreviewMouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="BoneCamera" Position="0,200,-50" LookDirection="0,-200,50" UpDirection="0,0,1" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:DirectionalLight3D x:Name="BoneHeadlamp" Direction="0,-1,0.5" Color="White"/>
                        <hx:DirectionalLight3D x:Name="BoneBacklamp" Direction="0,1,-0.5" Color="#FF808080"/>
                        <hx:GroupModel3D x:Name="BoneGroup"/>
                    </hx:Viewport3DX>
                </Grid>
            </Border>

            <!-- Occlusion Viewport -->
            <Border Grid.Column="2" Background="#FF161920" BorderBrush="#FF30343D" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="🦷 Occlusion STL" FontSize="12" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8" Panel.ZIndex="1"/>
                    <hx:Viewport3DX x:Name="OccViewport" BackgroundColor="#161920" ShowCoordinateSystem="False" ShowViewCube="False"
                                    PreviewMouseLeftButtonDown="OccViewport_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="OccViewport_PreviewMouseRightButtonDown">
                        <hx:Viewport3DX.Camera>
                            <hx:PerspectiveCamera x:Name="OccCamera" Position="0,200,-50" LookDirection="0,-200,50" UpDirection="0,0,1" NearPlaneDistance="0.1" FarPlaneDistance="10000"/>
                        </hx:Viewport3DX.Camera>
                        <hx:DirectionalLight3D x:Name="OccHeadlamp" Direction="0,-1,0.5" Color="White"/>
                        <hx:DirectionalLight3D x:Name="OccBacklamp" Direction="0,1,-0.5" Color="#FF808080"/>
                        <hx:GroupModel3D x:Name="OccGroup"/>
                    </hx:Viewport3DX>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF1E222A" BorderBrush="#FF30343D" BorderThickness="0,1,0,0" Padding="20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Selected 0 pairs. Need at least 3 to compute." VerticalAlignment="Center" Foreground="#FFA0AABF" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear All" Click="Clear_Click" Background="#FF30343D" Foreground="White" Padding="16,8" BorderThickness="0" Margin="0,0,12,0" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="ComputeBtn" Content="Compute Alignment" IsEnabled="False" Click="Compute_Click" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
