<Window x:Class="OrthoPlanner.App.SplintSequenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Splint Planner — Sequence &amp; Autorotation" Width="1200" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C1018" Foreground="White"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderTitle"
                       Text="Step 1: Surgical sequence, autorotation &amp; clearance"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="HeaderSubtitle" FontSize="11" Foreground="#AABBCC" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Lateral view. Choose which jaw is operated first, set the mandibular opening angle for the intermediate wafer, then click Continue."/>
        </StackPanel>

        <!-- 3D Viewport (left) -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
            <Grid>
                <hx:Viewport3DX x:Name="MainViewport" BackgroundColor="#FF0E1420"
                                ShowCoordinateSystem="True" CoordinateSystemLabelForeground="#00000000"
                                ZoomExtentsWhenLoaded="False"
                                IsRotationEnabled="True" IsPanEnabled="True" IsZoomEnabled="True"
                                RotateAroundMouseDownPoint="False"
                                CameraRotationMode="Turnball" ModelUpDirection="0,0,1"
                                ShowViewCube="False" IsInertiaEnabled="False"
                                MouseDown="Viewport_MouseDown"
                                MouseMove="Viewport_MouseMove"
                                MouseUp="Viewport_MouseUp">
                    <hx:Viewport3DX.Camera>
                        <hx:PerspectiveCamera x:Name="MainCamera"
                                              Position="-400,0,0" LookDirection="1,0,0"
                                              UpDirection="0,0,1" FieldOfView="40"
                                              NearPlaneDistance="0.1" FarPlaneDistance="20000"/>
                    </hx:Viewport3DX.Camera>
                    <hx:AmbientLight3D Color="#505050"/>
                    <hx:DirectionalLight3D x:Name="Headlamp" Direction="1,0,0"  Color="#D0D0D0"/>
                    <hx:DirectionalLight3D x:Name="Backlamp" Direction="-1,0,0" Color="#808080"/>
                    <hx:GroupModel3D x:Name="SceneGroup"/>
                </hx:Viewport3DX>
                <TextBlock x:Name="ViewportLabel"
                           Text="Lateral view — mandible hinges about the condylar axis"
                           FontSize="11" Foreground="#88FFFFFF"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Right panel -->
        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Background="#10FFFFFF" CornerRadius="4" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- SEQUENCE (hidden on Screen 3) -->
                    <StackPanel x:Name="SequenceSection">
                        <TextBlock Text="SEQUENCE" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,8"/>
                        <RadioButton x:Name="MaxillaFirstRadio" GroupName="SeqGroup"
                                     Content="Maxilla-first splint"
                                     Foreground="White" IsChecked="True"
                                     Checked="SequenceRadio_Changed" Margin="0,0,0,4"/>
                        <RadioButton x:Name="MandibleFirstRadio" GroupName="SeqGroup"
                                     Content="Mandible-first splint"
                                     Foreground="White"
                                     Checked="SequenceRadio_Changed" Margin="0,0,0,12"/>
                        <Separator Background="#30FFFFFF" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- AUTOROTATION -->
                    <TextBlock Text="AUTOROTATION" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,8"/>
                    <TextBlock Text="Opening angle (about condylar axis):" FontSize="11" Foreground="#AABBCC" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AngleLabel" Text="0.0°" FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,8,0,8"/>
                    <Slider x:Name="AngleSlider" Minimum="0" Maximum="20" Value="0"
                            SmallChange="0.1" LargeChange="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Margin="0,0,0,8" ValueChanged="AngleSlider_ValueChanged"/>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Button Content="−1°"   Margin="2" Padding="4" Click="DecCoarse_Click"  Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                        <Button Content="−0.1°" Margin="2" Padding="4" Click="DecFine_Click"    Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                        <Button Content="+0.1°" Margin="2" Padding="4" Click="IncFine_Click"    Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                        <Button Content="+1°"   Margin="2" Padding="4" Click="IncCoarse_Click"  Background="#30FFFFFF" Foreground="White" BorderThickness="0"/>
                    </UniformGrid>

                    <Separator Background="#30FFFFFF" Margin="0,0,0,12"/>

                    <!-- CLEARANCE -->
                    <TextBlock Text="CLEARANCE" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,6"/>
                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="ClearanceLabel" Text="—" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClearanceDetail" Text="" FontSize="10" Foreground="#AABBCC"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WarningLabel" Text="" FontSize="10" Foreground="#F80"
                               TextWrapping="Wrap" Margin="0,4,0,12"/>

                    <Separator Background="#30FFFFFF" Margin="0,0,0,12"/>

                    <!-- CONDYLAR AXIS -->
                    <TextBlock Text="CONDYLAR AXIS" FontSize="11" FontWeight="Bold" Foreground="#8CF" Margin="0,0,0,6"/>
                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="CondyleLeftLabel"  Text="L: (—)" FontSize="10" Foreground="#AABBCC" Margin="0,0,0,2"/>
                            <TextBlock x:Name="CondyleRightLabel" Text="R: (—)" FontSize="10" Foreground="#AABBCC"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="AdjustAxisToggle"
                                  Content="⊕  Adjust Axis"
                                  Padding="8,4" Margin="0,0,0,4"
                                  Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                                  Checked="AdjustAxisToggle_Checked" Unchecked="AdjustAxisToggle_Unchecked"/>
                    <TextBlock x:Name="AxisHintLabel" Text="" FontSize="10" Foreground="#88FFCC"
                               TextWrapping="Wrap" Margin="0,0,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Original Occlusion test (Screen 1 only) -->
            <Button x:Name="OriginalOcclusionBtn" Grid.Column="0"
                    Content="Original Occlusion (test)" Padding="10,5"
                    Background="#30FFFFFF" Foreground="#AABBCC" BorderThickness="0"
                    Click="OriginalOcclusion_Click"/>
            <!-- Footer right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ContinueBtn" Content="✔ Continue" Padding="14,6" Margin="0,0,8,0"
                        Background="#FF2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Click="Continue_Click"/>
                <Button Content="Cancel" Padding="12,6"
                        Background="#30FFFFFF" Foreground="White" BorderThickness="0"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
